{
  "name": "income-engine",
  "version": "1.0.0",
  "description": "CEO orchestrator plugin for income-engine — Paperclip, Ruflo, Graphy knowledge graph, lead-gen pipeline",
  "mcpServers": {
    "paperclip": {
      "command": "npx",
      "args": ["-y", "paperclip-mcp@latest"],
      "env": {
        "PAPERCLIP_BASE_URL": "http://localhost:3101",
        "PAPERCLIP_API_KEY": "90e4e195afa302a53b362433abea6d4fce3affe1b8f4777a289eef462cabb432"
      }
    },
    "claude-flow": {
      "command": "npx",
      "args": ["-y", "claude-flow@alpha", "mcp", "start"]
    },
    "ruv-swarm": {
      "command": "npx",
      "args": ["-y", "ruv-swarm", "mcp", "start"],
      "optional": true
    },
    "flow-nexus": {
      "command": "npx",
      "args": ["-y", "flow-nexus@latest", "mcp", "start"],
      "optional": true
    }
  }
}