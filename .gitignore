# Binary archives — should never live at repo root; use proper subdirs (apps/, infra/, etc.)
*.zip
!docs/**/*.zip
!assets/**/*.zip

# Nested workspace at repo root — accidentally-cloned/duplicated tree, not canonical
# Keep it on disk for inspection but never commit it.
Antigravity/

# VS Code workspace files reference local-only paths (e.g. OneDrive vault); keep local
*.code-workspace

# Empty stray from an aborted PowerShell redirect; harmless on disk, no value committed
Import-Module