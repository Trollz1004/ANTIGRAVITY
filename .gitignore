# Cloudflare
.wrangler/

# Docker
docker-compose.override.yml

# Binary archives — should never live at repo root; use proper subdirs (apps/, infra/, etc.)
*.zip
!docs/**/*.zip
!assets/**/*.zip

# Nested workspace at repo root — accidentally-cloned/duplicated tree, not canonical
# Keep it on disk for inspection but never commit it.
# Antigravity/

# VS Code workspace files reference local-only paths (e.g. OneDrive vault); keep local
*.code-workspace

# Empty stray from an aborted PowerShell redirect; harmless on disk, no value committed
Import-Module

# Hermes runtime cache + logs
.hermes/
hermes.log

# Per-machine Claude Code local overrides — never commit
.claude/settings.local.json

# Any env-style secrets file (*.env, *.env.txt, NSFWAdvanced-legacy.env, etc.)
# — never commit. Real secrets live in the OneDrive Personal Vault.
*.env
*.env.*
*ENV*.env
*credentials*.env
*credentials*.json

# Runtime artifacts that should never be committed
.playwright-mcp/
logs/*.err
logs/*.log
t5500-*.png

# Graphify knowledge-graph state — regenerated locally by post-commit hook
.graphify/
graphify-out/

# External tool clones (e.g. cff-initializer-javascript, gemini-cli) belong outside this repo per 1-folder rule
cff-initializer-javascript/
gemini-cli/

# Local debug / accidental files (Claude-added 2026-05-12)
nul
existing.txt
guard.txt
new-file.txt
logs/.watchdog-task-registered
