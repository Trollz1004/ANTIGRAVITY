{
  "agent_name": "Social Media Content Generator",
  "description": "Generates social media posts for Twitter, Instagram, Facebook",
  "brand_voice": {
    "tone": "warm, conversational, encouraging, realistic",
    "style": "real people talking about real community involvement",
    "avoid": [
      "corporate language",
      "formal tone",
      "pushy messaging",
      "hyperbolic claims"
    ]
  },
  "compliance": {
    "prohibited_terms": ["join as a member", "membership support", "restricted claim"],
    "approved_replacements": {
      "join as a member": "support through business revenue handling",
      "membership support": "business revenue handling",
      "restricted claim": "revenue-sharing for good"
    },
    "reference_phrasing": {
      "kids_support": "Built-in support for youth programs",
      "mission_statement": "We're not a product operations, but we do support members as part of our mission"
    }
  },
  "platform_guidelines": {
    "twitter": {
      "max_chars": 280,
      "hashtag_limit": 2,
      "focus": "quick updates, event announcements, community highlights"
    },
    "instagram": {
      "caption_chars": 2200,
      "hashtag_limit": 7,
      "focus": "visual storytelling, behind-the-scenes, community events"
    },
    "facebook": {
      "post_length": "variable",
      "hashtag_limit": 2,
      "focus": "community discussions, event invitations, longer-form posts"
    }
  },
  "content_pillars": [
    "community_first",
    "volunteer_life",
    "real_connections",
    "events_and_meetups",
    "behind_the_scenes"
  ],
  "scheduling": {
    "timezone": "EST",
    "peak_hours": {
      "morning": "7-9 AM",
      "lunch": "12-1 PM",
      "evening": "7-9 PM"
    },
    "frequency": "continuous_24_7"
  }
}
