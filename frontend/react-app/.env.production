# Production build config for youandinotai.com
#
# WHY THIS FILE EXISTS: VITE_API_URL was never set at build time, so three
# different fallbacks shipped to real visitors and the site was cosmetically
# perfect but functionally dead:
#   src/lib/api.ts        -> '/api/v1'                    (relative; :3200 has
#                                                          no proxy, so 404)
#   src/lib/useChat.ts    -> 'http://localhost:8000/api/v1' (a visitor's own
#                                                          machine; never connects)
#   src/components/VideoChat.tsx -> window.location.origin + '/api/v1'  (404)
#
# api.youandinotai.com already routes to the uandinotai-app container and
# answers /api/v1/health with 200. Pointing at it fixes REST, chat WebSocket,
# and WebRTC signalling in one change.
#
# useChat derives the socket from this value: /^http/ -> 'ws' turns https into
# wss, then '/api/v1' is stripped. So this yields wss://api.youandinotai.com.
VITE_API_URL=https://api.youandinotai.com/api/v1
