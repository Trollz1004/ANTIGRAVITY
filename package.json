{
  "private": true,
  "name": "antigravity-monorepo",
  "description": "ANTIGRAVITY monorepo — YouAndINotAI platform (1-repo policy)",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "pnpm --filter @antigravity/web dev",
    "dev:dashboard": "pnpm --filter @antigravity/dashboard dev",
    "dev:openclaw": "pnpm --filter @antigravity/openclaw dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.4.0"
  }
}
