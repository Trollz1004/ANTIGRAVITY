{
  "private": true,
  "name": "antigravity-monorepo",
  "description": "ANTIGRAVITY monorepo — YouAndINotAI platform (1-repo policy)",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "pnpm --filter ai-studio-applet dev",
    "dev:dashboard": "pnpm --filter antigravity-mission-control dev",
    "dev:mission-control": "pnpm --filter mission-control dev",
    "dev:cockpit": "pnpm --filter @antigravity/cockpit dev",
    "dev:openclaw": "pnpm --filter opuspawclaw dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write ."
  },
