{
  "private": true,
  "name": "antigravity-monorepo",
  "description": "ANTIGRAVITY monorepo \u2014 YouAndINotAI platform (1-repo policy)",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "pnpm --filter ai-studio-applet dev",
    "dev:dashboard": "pnpm --filter antigravity-mission-control dev",
    "dev:mission-control": "pnpm --filter mission-control dev",
    "dev:cockpit": "pnpm --filter @antigravity/cockpit dev",
    "dev:openclaw": "pnpm --filter opuspawclaw dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "fable": "node scripts/fable/fable.mjs"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-react-app": "^5.2.1",
    "prettier": "^3.8.3"
  },
  "dependencies": {
    "@supabase/server": "^1.9.2",
    "agent-browser": "^0.35.0",
    "fdir": "^6.5.0",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "@modelcontextprotocol/sdk": "^1.32.0",
      "brace-expansion@1": "^1.1.20",
      "browserslist": "^4.28.7",
      "fast-uri@3": "^3.1.6",
      "hono": "^4.12.34",
      "ip-address": "^10.3.1",
      "js-yaml@4": "^4.3.2",
      "nanoid@3": "^3.3.18",
      "postcss": "^8.5.23",
      "proxy-addr": ">=2.0.8",
      "shell-quote": ">=1.11.0",
      "source-map-js": ">=1.2.2",
      "tinypool": ">=2.1.2",
      "undici@7": "^7.30.1",
      "vite@<=6.4.3": "^6.4.4",
      "vite@>=8.2.0 <=8.2.3": "^8.2.4",
      "vitest@<3.2.6": "^3.2.6",
      "zod": "^4.6.6",
      "body-parser@1": "^1.20.9",
      "body-parser@2": "^2.4.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
