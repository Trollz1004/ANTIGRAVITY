# YouAndINotAI FastAPI Backend Environment Variables Example

# Application Settings
APP_NAME="YouAndINotAI API"
APP_VERSION="0.1.0"
APP_ENV="development" # or "production", "test"

# Database Configuration
# Primary production database (Supabase Postgres). Keep the real password in the vault only.
SUPABASE_DB_URL="postgresql://postgres:[password]@db.jmvgdqomvnkfgknmgwxp.supabase.co:5432/postgres"
# Fallback local/T5500 database when SUPABASE_DB_URL is unset.
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/youandinotai"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Payment Processor (Square)
SQUARE_ACCESS_TOKEN=""
SQUARE_LOCATION_ID=""
# Square hosted-checkout links — one-line swap from .env without code change.
# Fallback hardcoded values in app/payments.py keep the site live if unset.
SQUARE_BOT_SHIELD_PAYMENT_LINK=""
SQUARE_FOUNDING_MEMBER_PAYMENT_LINK=""
SQUARE_3MONTH_PAYMENT_LINK=""
SQUARE_12MONTH_PAYMENT_LINK=""
SQUARE_ROYALTY_PAYMENT_LINK=""
SQUARE_SUBSCRIPTION_PAYMENT_LINK=""
SQUARE_PAYMENT_WEBHOOK_SIGNATURE_KEY=""
SQUARE_PAYMENT_WEBHOOK_NOTIFICATION_URL=""
SQUARE_BOOKING_WEBHOOK_SIGNATURE_KEY=""
SQUARE_BOOKING_WEBHOOK_NOTIFICATION_URL=""
SQUARE_WEBHOOK_SIGNATURE_KEY="" # Deprecated - use payment/booking specific ones
SQUARE_WEBHOOK_NOTIFICATION_URL="" # Deprecated - use payment/booking specific ones
SQUARE_WEBHOOK_VERIFY_SIGNATURE=true
SQUARE_BOOKING_LOG_DIR=""
SQUARE_API_BASE_URL="https://connect.squareup.com"
SQUARE_API_VERSION="2026-01-22"

# Email Settings
APP_URL="https://youandinotai.com"
EMAIL_FROM_ADDRESS=""
EMAIL_FROM_NAME="YouAndINotAI"
EMAIL_REPLY_TO=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_USE_SSL=false
SMTP_USE_STARTTLS=true

# Messaging and AI Integrations
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
SUPPORT_OPERATOR_EMAILS=""
SUPPORT_OPENCLAW_URL=""
SUPPORT_OPENCLAW_TIMEOUT_SECONDS=15.0
SUPPORT_ANYTHINGLLM_API_URL="" # Example: http://localhost:3001/api/v1
SUPPORT_ANYTHINGLLM_API_KEY="" # Keep real key in private env/vault only
SUPPORT_ANYTHINGLLM_WORKSPACE_SLUG="antigravity-support"
SUPPORT_ANYTHINGLLM_TIMEOUT_SECONDS=15.0
SUPPORT_OLLAMA_BASE_URL=""
# Local AnythingLLM support launcher creates this CPU-safe alias from qwen2.5:0.5b.
SUPPORT_OLLAMA_MODEL="youandinotai-support-cpu:latest"
SUPPORT_OLLAMA_TIMEOUT_SECONDS=10.0
SUPPORT_OLLAMA_CONTEXT_TOKENS=1024
SUPPORT_OLLAMA_NUM_PREDICT=220
SUPPORT_OLLAMA_NUM_GPU=0
# Hard overall deadline across all support rails so a slow provider can't push
# total latency past what callers/proxies expect. Default 20s.
SUPPORT_TOTAL_TIMEOUT_SECONDS=20.0
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-pro"
KIMI_API_KEY=""
KIMI_MODEL="kimi-2.6"
DAILY_API_KEY=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ClawX 6-AI Council Integration
CLAWX_ENABLED=false
CLAWX_BASE_URL="https://api.clawx.example.com"
CLAWX_AGENT_KEYS="{}" # JSON dict of agent_name: api_key (e.g., '{"claude": "sk-ant-...", "gemini": "AIza..."}')

# Security & Access
JWT_SECRET="" # REQUIRED: Must be at least 32 characters long. Generate with: python -c 'import secrets; print(secrets.token_urlsafe(64))'
METRICS_API_KEY="" # Separate key for /metrics endpoint
BETA_ACCESS_CODES="" # Comma-separated list of access codes
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CDN / Static Assets
CDN_BASE_URL=""
CDN_ENABLED=false

# Redis
REDIS_URL="redis://localhost:6379/0"

# File Uploads
UPLOAD_ALLOWED_TYPES="image/jpeg,image/png,image/webp,image/gif,application/pdf"
UPLOAD_MAX_SIZE_MB=5

# CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:8000"

# Rate Limiting
RATE_LIMIT_TRUSTED_PROXIES="" # Comma-separated list of trusted proxy IPs/CIDRs

# Monitoring
SENTRY_DSN=""
PROMETHEUS_PORT=8000

# Request Limits (DoS Protection)
MAX_REQUEST_BODY_SIZE=1048576 # 1MB
MAX_FILE_UPLOAD_SIZE=5242880 # 5MB
MAX_JSON_DEPTH=10

# OpenTelemetry Tracing
OTEL_SERVICE_NAME="youandinotai-api"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318/v1/traces"
