{
  "name": "antigravity-contracts",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "compile": "npx hardhat compile",
    "deploy": "npx hardhat run scripts/deploy.js --network base",
    "deploy:charity": "npx hardhat run scripts/deploy-charity.js --network base",
    "verify": "npx hardhat run scripts/verify.js --network base",
    "test": "npx hardhat test",
    "coverage": "npx hardhat coverage",
    "coverage:ci": "npx hardhat coverage --temp artifacts"
  },
  "devDependencies": {
    "hardhat": "^2.22.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.1.0",
    "solidity-coverage": "^0.8.5"
  }
}