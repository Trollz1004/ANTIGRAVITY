// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id               String   @id @default(cuid())
  stripeSessionId  String   @unique
  customerEmail    String?
  amountTotal      Int      // In cents
  currency         String   @default("usd")
  
  // Protocol Omega Split (Stored in cents to avoid rounding issues)
  shrinersShare    Int      // 60%
  infraShare       Int      // 30%
  founderShare     Int      // 10%
  
  status           String   @default("completed") // completed, refunded, disputed
  productType      String?  // Bot-Shield, Founding Member, etc.
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
}

model SystemMetric {
  id        String   @id @default("singleton")
  totalUsers Int      @default(0)
  lastUpdated DateTime @default(now())
}
