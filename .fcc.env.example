# Routing (FCC-Claude through OmniRoute gateway as PRIMARY)
# Use LAN IP 192.168.0.8 for laptop access; token-based VS Code endpoint
# COPY THIS FILE TO: C:\Users\joshl\.fcc\.env
# IMPORTANT: Add real token from C:\Users\joshl\.env (master vault)

# Routing (read from master .env, never hardcode)
OMNIROUTE_BASE=http://192.168.0.8:20128/api/v1/vscode/YOUR_OMNIROUTE_TOKEN/
OMNIROUTE_API_KEY=YOUR_OMNIROUTE_TOKEN
OMNIROUTE_MODELS=http://192.168.0.8:20128/api/v1/vscode/YOUR_OMNIROUTE_TOKEN/models
OMNIROUTE_CHAT=http://192.168.0.8:20128/api/v1/vscode/YOUR_OMNIROUTE_TOKEN/chat/completions
BEDROCK_BASE_URL=http://192.168.0.8:20128/api/v1/vscode/YOUR_OMNIROUTE_TOKEN/
BEDROCK_PROXY=http://192.168.0.8:20128/api/v1/vscode/YOUR_OMNIROUTE_TOKEN/

# Model Routing (from master .env)
MODEL=bedrock/auto/best-coding
MODEL_FABLE=
MODEL_OPUS=bedrock/cc/claude-opus-4-8
MODEL_SONNET=bedrock/auto/best-coding
MODEL_HAIKU=bedrock/auto/best-fast

# Reasoning
REASONING_POLICY=client
REASONING_FABLE=inherit
REASONING_OPUS=inherit
REASONING_SONNET=inherit
REASONING_HAIKU=inherit

# Runtime
ANTHROPIC_AUTH_TOKEN=freecc
PROVIDER_RATE_LIMIT=1
PROVIDER_RATE_WINDOW=3
PROVIDER_MAX_CONCURRENCY=5
HTTP_READ_TIMEOUT=300
HTTP_WRITE_TIMEOUT=60
HTTP_CONNECT_TIMEOUT=60
HOST=0.0.0.0
PORT=8082

# Task submission
PAPERCLIP_BASE=http://localhost:3120
MISSION_CONTROL_BASE=http://localhost:3151

# Memory & skills
PIECES_MCP_ENDPOINT=http://localhost:39300/model_context_protocol/2025-03-26/mcp
SKILLS_DIR=C:\Users\joshl\.agents\skills

# Logging
LOG_DIR=C:\Users\joshl\.fcc\logs
LOG_LEVEL=info

# Runtime
STATE_FILE=C:\Users\joshl\.fcc\STATE.md
CLAUDE_IDENTITY=C:\Users\joshl\.fcc\claude.md

# SECURITY: Do NOT commit this file with real tokens. Keep only in C:\Users\joshl\.fcc\.env
