# OmniRouter — T5500 environment config
# Copy to .env on T5500 and fill in real keys (NEVER commit .env)
# Start: node scripts/start-omni-router.ps1 OR cd services/omni-router && node src/index.js

HOST=127.0.0.1
PORT=11436

# REQUIRED: set to 1 to actually proxy requests (safe-off by default)
OMNI_ROUTER_PROXY_ENABLED=1

# Default provider when no policy is set
OMNI_ROUTER_DEFAULT_PROVIDER=openrouter

# Ollama (free local GPU — always enabled unless set to 0)
OMNI_ROUTER_ENABLE_OLLAMA=1
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1/chat/completions

# OpenRouter (free tier — NVIDIA/Nemotron models available without key)
OMNI_ROUTER_ENABLE_OPENROUTER=1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=sk-or-...

# FCC/OpenCode bridge (legacy — proxy removed; use OpenRouter path above)
# OMNI_ROUTER_ENABLE_FCC=0
# FCC_CHAT_URL=http://127.0.0.1:8082/v1/chat/completions

# NVIDIA endpoints (optional paid path via OpenRouter)
# NVIDIA_API_KEY=nvapi-...

# OpenAI (paid — decision lane only)
# OPENAI_API_KEY=sk-...

# xAI Grok (paid)
# XAI_API_KEY=xai-...
