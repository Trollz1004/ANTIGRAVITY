# Agent Hub — Environment Configuration
# Copy to .env and fill in values. NEVER commit .env to git.

# --- Service ---
PORT=3130
DATABASE_URL=postgresql://localhost:5432/agent_hub

# --- Internal API auth (hub-to-hub, agents calling the API) ---
AGENT_HUB_API_KEY=changeme-generate-a-uuid

# --- Slack (bot token from Slack app — Joshua creates in browser) ---
# Channels: #antigravity-platform, #dream-online, #fcc-claude
SLACK_BOT_TOKEN=xoxb-your-token-here
SLACK_CHANNEL_PLATFORM=antigravity-platform
SLACK_CHANNEL_DREAM=dream-online
SLACK_CHANNEL_FCC=fcc-claude

# --- GitHub (for issue sync — fine-grained PAT, repo scope only) ---
GITHUB_TOKEN=ghp_your-token-here
GITHUB_REPO=Trollz1004/ANTIGRAVITY

# --- Leads CRM (services/agent-hub/src/leads) ---
# All of the below are OPTIONAL and default-OFF. A missing/empty value disables
# that integration cleanly — none of them are hard dependencies for the leads API.
SLACK_CHANNEL_LEADS=antigravity-platform
HERMES_MEMORY_URL=http://localhost:9119/memory/upsert
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional AI-assisted lead scorer (OpenAI-compatible /v1/chat/completions).
# Absent from the vault as of this writing — leave unset until provisioned.
ONEMINAI_API_KEY=
ONEMINAI_BASE_URL=https://api.1min.ai/v1
ONEMINAI_MODEL=gpt-4o-mini
# Legacy Emergent CRM integrations — default-OFF, no hard dependency on any
# *.emergent* host. Only set these if/when a real ledger/broadcast endpoint exists.
EMERGENT_LEDGER_URL=
EMERGENT_BROADCAST_URL=

# === AUTH MODEL ===
# The hub does NOT hold keys for browser-auth platforms:
#   - Codex (OpenAI) = browser sign-in on desktop app
#   - Grok (xAI) = browser sign-in on desktop app
#   - Claude official = browser sign-in on claude.ai/desktop
#   - Gemini (Google) = browser sign-in on desktop app
#
# These platforms are accessed through their native desktop CLIs.
# The hub only TRACKS tasks assigned to them — it doesn't call their APIs.
#
# Local services that DON'T need keys (they're on localhost):
#   - FCC proxy: http://127.0.0.1:8082 (no auth needed)
#   - Ollama: http://127.0.0.1:11434 (no auth needed)
#   - Hermes router: http://127.0.0.1:11435 (no auth needed)
