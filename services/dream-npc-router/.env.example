# dream-npc-router — environment variables (copy to .env, fill in locally, NEVER commit .env)

# --- Server ---
PORT=
LOG_LEVEL=

# --- Resilience ---
ROUTER_TIMEOUT_MS=
CIRCUIT_BREAKER_THRESHOLD=
CIRCUIT_BREAKER_COOLDOWN_MS=

# --- Child safety ---
# Keep false. Only flip if a reviewed, explicitly-approved child-safe cloud path exists.
ENABLE_CHILD_MODE_CLOUD=

# --- Ollama (local, T0 + child-mode + degrade target) ---
OLLAMA_BASE_URL=
OLLAMA_MODEL_T0=

# --- 1Min.ai (T1 primary) — schema UNVERIFIED, see README ---
ONEMIN_API_KEY=
ONEMIN_BASE_URL=
ONEMIN_MODEL_T1=
# api-key | bearer
ONEMIN_AUTH_STYLE=
ONEMIN_RATE_LIMIT_PER_MIN=

# --- AIHubMix (T1 overflow / T2 placeholder) ---
AIHUBMIX_API_KEY=
AIHUBMIX_BASE_URL=
AIHUBMIX_MODEL_OVERFLOW=
