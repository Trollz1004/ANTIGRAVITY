{
  "$schema": "https://opencode.ai/config.json",
  "theme": "opencode",
  "autoshare": false,
  "autoupdate": true,
  "provider": {
    "codex": {
      "npm": "@ai-sdk/openai",
      "name": "Codex (auth — OpenAI / ChatGPT)",
      "options": { "apiKey": "{env:OPENAI_API_KEY}" },
      "models": {
        "codex-mini-5.3": { "name": "Codex Mini 5.3 (browser sign-in only)" }
      }
    },
    "openai": {
      "options": { "apiKey": "{env:OPENAI_API_KEY}" },
      "models": {
        "gpt-5":      { "name": "GPT-5 (deep)" },
        "gpt-5-mini": { "name": "GPT-5 mini (cheap)" },
        "o3":         { "name": "o3 (reasoning)" }
      }
    },
    "google": {
      "options": { "apiKey": "{env:GEMINI_API_KEY}" },
      "models": {
        "gemini-2.5-pro":   { "name": "Gemini 2.5 Pro" },
        "gemini-2.5-flash": { "name": "Gemini 2.5 Flash (FREE 15 RPM / 1M tok/day)" }
      }
    },
    "xai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "xAI Grok (auth — x.AI Builder / API key)",
      "options": {
        "baseURL": "https://api.x.ai/v1",
        "apiKey":  "{env:XAI_API_KEY}"
      },
      "models": {
        "grok-3":       { "name": "Grok 3 (xAI builder auth)" },
        "grok-3-mini":  { "name": "Grok 3 Mini (fast)" },
        "grok-3-reasoning": { "name": "Grok 3 Reasoning (deep)" }
      }
    },
    "nous": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Nous Research",
      "options": {
        "baseURL": "https://inference-api.nousresearch.com/v1",
        "apiKey":  "{env:NOUS_API_KEY}"
      },
      "models": {
        "Hermes-4-405B":   { "name": "Hermes-4 405B" },
        "Hermes-4-70B":    { "name": "Hermes-4 70B" },
        "Hermes-4.3-36B":  { "name": "Hermes-4.3 36B" }
      }
    },
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter (paid — free models available as options)",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey":  "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "openrouter/free":                                        { "name": "OpenRouter Free (auto-best)" },
        "meta-llama/llama-3.3-70b-instruct:free":                 { "name": "Llama 3.3 70B (free)" },
        "meta-llama/llama-3.2-3b-instruct:free":                  { "name": "Llama 3.2 3B (free)" },
        "google/gemma-4-31b-it:free":                             { "name": "Gemma 4 31B (free)" },
        "google/gemma-4-26b-a4b-it:free":                         { "name": "Gemma 4 26B (free)" },
        "qwen/qwen3-coder:free":                                  { "name": "Qwen3 Coder (free)" },
        "qwen/qwen3-next-80b-a3b-instruct:free":                  { "name": "Qwen3 Next 80B (free)" },
        "nousresearch/hermes-3-llama-3.1-405b:free":              { "name": "Hermes 3 405B (free)" },
        "nvidia/nemotron-3-super-120b-a12b:free":                 { "name": "Nemotron 3 Super 120B (free)" },
        "nvidia/nemotron-3-ultra-550b-a55b:free":                 { "name": "Nemotron 3 Ultra 550B (free)" },
        "openai/gpt-oss-120b:free":                               { "name": "GPT-OSS 120B (free)" },
        "openai/gpt-oss-20b:free":                                { "name": "GPT-OSS 20B (free)" },
        "liquid/lfm-2.5-1.2b-instruct:free":                      { "name": "LFM 2.5 1.2B (free)" },
        "cognitivecomputations/dolphin-mistral-24b-venice-edition:free": { "name": "Dolphin Mistral 24B (free)" },
        "x-ai/grok-3:free":                                       { "name": "Grok 3 (free — OpenRouter)" },
        "x-ai/grok-3-mini:free":                                  { "name": "Grok 3 Mini (free — OpenRouter)" },
        "cohere/north-mini-code:free":                            { "name": "Cohere North Mini Code (free)" },
        "nvidia/nemotron-3.5-content-safety:free":                { "name": "Nemotron 3.5 Content Safety (free)" },
        "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free":     { "name": "Nemotron 3 Nano Omni Reasoning (free)" },
        "poolside/laguna-xs.2:free":                              { "name": "Poolside Laguna XS.2 (free)" },
        "poolside/laguna-m.1:free":                               { "name": "Poolside Laguna M.1 (free)" },
        "liquid/lfm-2.5-1.2b-thinking:free":                      { "name": "LFM 2.5 1.2B Thinking (free)" },
        "nvidia/nemotron-3-nano-30b-a3b:free":                    { "name": "Nemotron 3 Nano 30B (free)" },
        "nvidia/nemotron-nano-12b-v2-vl:free":                    { "name": "Nemotron Nano 12B VL (free)" },
        "nvidia/nemotron-nano-9b-v2:free":                        { "name": "Nemotron Nano 9B V2 (free)" }
      }
    },
    "opencode": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode (Zen free models + curated)",
      "options": {
        "baseURL": "https://opencode.ai/zen/v1",
        "apiKey":  "{env:OPENCODE_API_KEY}"
      },
      "models": {
        "big-pickle":            { "name": "Big Pickle (free)" },
        "deepseek-v4-flash-free": { "name": "DeepSeek V4 Flash Free" },
        "mimo-v2.5-free":        { "name": "MiMo V2.5 Free" },
        "north-mini-code-free":  { "name": "North Mini Code Free" },
        "nemotron-3-ultra-free": { "name": "Nemotron 3 Ultra Free" }
      }
    },
    "ollama-cloud": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Cloud",
      "options": {
        "baseURL": "https://ollama.com/v1",
        "apiKey":  "{env:OLLAMA_API_KEY}"
      },
      "models": {
        "joshlcoleman/CFO-Until-No-Kid-In-Need:latest":   { "name": "CFO PRIME (your model)" },
        "joshlcoleman/dateapp-marketing:latest":          { "name": "Marketing (your model)" },
        "jeffreyvandekorput/korpohermes-prime:latest":    { "name": "Hermes Prime (cloud)" },
        "kimi-k2.7-code:cloud":                            { "name": "Kimi K2.7 Code (frontier coding)" },
        "kimi-k2.6:cloud":                                 { "name": "Kimi K2.6" },
        "gemma4:cloud":                                    { "name": "Gemma 4 (cloud)" },
        "qwen3.5:cloud":                                   { "name": "Qwen 3.5 (cloud)" },
        "minimax-m3:cloud":                                { "name": "MiniMax M3 (1M context)" },
        "glm-5.1:cloud":                                   { "name": "GLM 5.1" }
      }
    },
    "ollama-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Ollama (FREE — canonical self-hosted for Paperclip/OpenCode; attach via http://localhost:11434/v1)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey":  "ollama"
      },
      "models": {
        "gemma4:latest":            { "name": "Gemma 4 8B (Q4_K_M)" },
        "gemma2:latest":            { "name": "Gemma 2 9B" },
        "gemma3:1b":                { "name": "Gemma 3 1B (tiny)" },
        "qwen2.5:7b":               { "name": "Qwen2.5 7B" },
        "qwen2.5-coder:7b":        { "name": "Qwen2.5-Coder 7B" },
        "qwen3.5:latest":           { "name": "Qwen3.5 9.7B" },
        "nomic-embed-text:latest":  { "name": "Nomic Embed Text 137M" },
        "joshlcoleman/CFO-Until-No-Kid-In-Need:latest": { "name": "CFO PRIME (fine-tune)" },
        "joshlcoleman/dateapp:latest":                   { "name": "DateApp (fine-tune)" },
        "joshlcoleman/dateapp-marketing:latest":         { "name": "DateApp Marketing (fine-tune)" }
      }
    },
    "ollama-opencode": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama-OpenCode (local bridge for Paperclip adapters; delegates to canonical ollama-local)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey":  "ollama"
      },
      "models": {
        "qwen2.5-coder:7b": { "name": "Qwen2.5-Coder 7B (opencode bridge)" },
        "gemma4:latest":    { "name": "Gemma 4 8B (opencode bridge)" }
      }
    },
    "hermes-router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Hermes Router (services/hermes-router — auto-fallback)",
      "options": {
        "baseURL": "http://localhost:11435/v1",
        "apiKey":  "router-auth"
      },
      "models": {
        "hermes":        { "name": "Hermes (default)" },
        "hermes-deep":   { "name": "Hermes Deep (405B)" },
        "hermes-fast":   { "name": "Hermes Fast (36B)" },
        "hermes-reason": { "name": "Hermes Reason (think tags)" },
        "code":          { "name": "Code (local Qwen + fallback)" },
        "fast":          { "name": "Fast (local Llama)" },
        "cfo":           { "name": "CFO (cloud + fallback)" },
        "marketing":     { "name": "Marketing (cloud + fallback)" },
        "kimi":          { "name": "Kimi (cloud + fallback)" }
      }
    }
  },
  "model": "hermes-router/hermes",
  "agent": {
    "orchestrator": {
      "description": "High-quality orchestrator. Route planning to OpenAI/Codex or OpenRouter free, execution to cheaper models.",
      "model": "codex/gpt-5.5"
    },
    "coder": {
      "description": "Code writer. Prefers local or free models first.",
      "model": "ollama-local/qwen2.5-coder:7b"
    },
    "closer": {
      "description": "Demo + proposal builder for paid gigs. Max quality.",
      "model": "openrouter/meta-llama/llama-3.3-70b-instruct:free"
    },
    "hunter": {
      "description": "Gig hunter / lead scorer. Cheap and fast.",
      "model": "hermes-router/hermes-fast"
    },
    "cfo": {
      "description": "Financial gating + revenue tracking for #UNTILnoKIDinNEED.",
      "model": "hermes-router/cfo"
    },
    "grok-adversarial": {
      "description": "Red-team / adversarial review via Grok.",
      "model": "xai/grok-3"
    },
    "free-fast": {
      "description": "Quick tasks using free OpenRouter models.",
      "model": "openrouter/openrouter/free"
    }
  }
}
