# OPUS-9020 Environment Template
# Copy this to .env and fill in your keys
# NEVER commit .env to git — it's in .gitignore

# === Claude API (OpenClaw) ===
ANTHROPIC_API_KEY=sk-ant-oat01-YOUR_TOKEN_HERE
CLAUDE_MODEL=claude-opus-4-5-20250514

# === Ollama (local embeddings) ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# === Redis (session memory) ===
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=openclaw:
SESSION_TTL=86400

# === Qdrant (vector memory) ===
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=openclaw_memory

# === Servers ===
OPENCLAW_PORT=3200
MCP_PORT=3100
LOG_LEVEL=info

# === API Keys ===
ANTHROPIC_ADMIN_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
REPLICATE_API_KEY=
STABILITY_API_KEY=
PERPLEXITY_API_KEY=
PEXELS_API_KEY=
UNSPLASH_API_KEY=

# === Payment ===
SQUARE_ACCESS_TOKEN=
SQUARE_APP_ID=
SQUARE_LOCATION_ID=
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

# === Social ===
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=
META_ACCESS_TOKEN=
