# YouAndINotAI — Environment Variables Example
# Copy this to .env and fill in the values.
# The Iron Wall: Never commit real secrets to git.

# ── Core ──
APP_NAME="YouAndINotAI API"
APP_VERSION="0.1.0"
APP_ENV=development
APP_URL=https://youandinotai.com
CORS_ORIGINS=https://youandinotai.com,http://localhost:3000,http://localhost:5173

# ── Database ──
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/youandinotai

# ── Security ──
# Generate a secure secret with: python -c 'import secrets; print(secrets.token_urlsafe(64))'
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
METRICS_API_KEY=

# ── Payments (Square) ──
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_BOT_SHIELD_PAYMENT_LINK=https://square.link/u/Qc5mxUy7
SQUARE_SUBSCRIPTION_PAYMENT_LINK=https://square.link/u/cxwjcn0s
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_API_BASE_URL=https://connect.squareup.com
SQUARE_API_VERSION=2026-01-22

# ── Video (Daily.co) ──
DAILY_API_KEY=

# ── AI Models ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
KIMI_API_KEY=
KIMI_MODEL=kimi-2.6

# ── Email (SMTP) ──
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME="YouAndINotAI"
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=False
SMTP_USE_STARTTLS=True

# ── Rate Limiting ──
REGISTRATION_RATE_LIMIT_PER_MINUTE=10
AUTH_RATE_LIMIT_PER_MINUTE=10
VERIFY_RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_TRUSTED_PROXIES=127.0.0.1/32,::1/128
