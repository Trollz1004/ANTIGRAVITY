# ====================================================================
# ANTIGRAVITY - Paperclip + Ollama + Claude Code Integration
# Environment Configuration for Docker Compose
# ====================================================================

# ---- Local Ollama Configuration ----
OLLAMA_HOST=192.168.0.8:11434
OLLAMA_MODEL=gemma4:31b

# ---- LiteLLM Proxy Configuration ----
LITELLM_CONFIG_PATH=/app/config.yaml
LITELLM_LOG_LEVEL=INFO
LITELLM_PORT=11435

# ---- Paperclip Configuration ----
PAPERCLIP_WORKSPACE=/workspace/paperclip
WORKING_DIR=/workspace/antigravity
NODE_ENV=production
DATABASE_URL=postgresql://paperclip:paperclip@postgres:5432/paperclip

# ---- PostgreSQL Configuration ----
POSTGRES_USER=paperclip
POSTGRES_PASSWORD=paperclip
POSTGRES_DB=paperclip

# ---- Claude Code Agents Configuration ----
OPENAI_API_BASE=http://litellm-proxy:8000/v1
OPENAI_MODEL=gemma4:31b
OPENAI_API_KEY=sk-fakekey123

# ---- Cloud Subscription Keys (Optional - set only if using cloud backends) ----
# Together.ai API Key (for Llama 3.2 70B)
TOGETHER_API_KEY=sk-your-together-api-key-here

# Anthropic API Key (for Claude 3.5 Sonnet via cloud)
ANTHROPIC_API_KEY=sk-your-anthropic-api-key-here

# Replicate API Key (alternative cloud provider)
REPLICATE_API_TOKEN=your-replicate-token-here

# ---- Advanced Settings ----
# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Caching
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CACHE_ENABLED=true

# Agent scaling
MAX_CONCURRENT_AGENTS=10
AGENT_TIMEOUT_SECONDS=120
AGENT_RETRY_COUNT=3

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
