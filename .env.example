# ═══════════════════════════════════════════════════════════════════════════════
# ANTIGRAVITY — Environment Variable Reference
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# NEVER commit .env to git. Real secrets live in the OneDrive Personal Vault.
# This file is the authoritative key list — committed, but with only placeholders.
#
# Deployment mode: local_trusted (Paperclip instance)
# ═══════════════════════════════════════════════════════════════════════════════

# ── CORE / REQUIRED ──────────────────────────────────────────────────────────
# The app WILL NOT start without these.

# PostgreSQL connection string (asyncpg driver)
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/antigravity"

# JWT signing secret — MUST be at least 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# The app will REFUSE to start if this is empty, too short, or a known default.
JWT_SECRET="change-me-generate-a-64-char-secret-with-secrets-token-urlsafe"

# Application environment: development | staging | production | test
NODE_ENV="development"

# Application URL — used for OAuth callbacks, webhook URLs, self-referential links
APP_URL="http://localhost:3000"

# ── BACKEND API (FastAPI) ────────────────────────────────────────────────────
# Port the FastAPI server listens on
PORT="8000"

# Log level: debug | info | warn | error
LOG_LEVEL="info"

# Application environment label (backend-specific)
APP_ENV="development"

# CORS allowed origins — comma-separated list of URLs
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# ── DATABASE POOLING ─────────────────────────────────────────────────────────
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_POOL_RECYCLE=1800

# ── REDIS ────────────────────────────────────────────────────────────────────
# Redis connection URL
REDIS_URL="redis://localhost:6379/0"

# Redis server details (used by some services that construct their own URL)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ── QDRANT (Vector DB) ───────────────────────────────────────────────────────
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION="antigravity"
QDRANT_API_KEY=""

# ── SQUARE PAYMENTS ──────────────────────────────────────────────────────────
# Square API access token — from Square Developer Dashboard
SQUARE_ACCESS_TOKEN=""

# Square location ID — from Square Developer Dashboard
SQUARE_LOCATION_ID=""

# Square environment: sandbox | production
SQUARE_ENV="sandbox"

# Pre-configured Square payment link for $1 Bot-Shield verification
SQUARE_BOT_SHIELD_PAYMENT_LINK=""

# Pre-configured Square payment link for subscriptions
SQUARE_SUBSCRIPTION_PAYMENT_LINK=""

# Square webhook signature keys — for verifying incoming webhooks
SQUARE_PAYMENT_WEBHOOK_SIGNATURE_KEY=""
SQUARE_PAYMENT_WEBHOOK_NOTIFICATION_URL=""
SQUARE_BOOKING_WEBHOOK_SIGNATURE_KEY=""
SQUARE_BOOKING_WEBHOOK_NOTIFICATION_URL=""
SQUARE_WEBHOOK_SIGNATURE_KEY=""
SQUARE_WEBHOOK_NOTIFICATION_URL=""

# Verify Square webhook signatures: true | false
SQUARE_WEBHOOK_VERIFY_SIGNATURE="true"

# Directory for Square booking log files
SQUARE_BOOKING_LOG_DIR="/app/ewaste-intake-data/bookings"

# Square API version and base URL
SQUARE_API_BASE_URL="https://connect.squareup.com"
SQUARE_API_VERSION="2026-01-22"

# ── AI / LLM PROVIDERS ───────────────────────────────────────────────────────
# Google Gemini (AI Studio)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-pro"

# Anthropic Claude
ANTHROPIC_API_KEY=""

# OpenAI (used by CodeX)
OPENAI_API_KEY=""

# xAI Grok
XAI_API_KEY=""

# Perplexity Sonar
SONAR_API_KEY=""

# Kimi (Moonshot)
KIMI_API_KEY=""
KIMI_MODEL="kimi-2.6"

# Daily.co (video rooms)
DAILY_API_KEY=""

# Ollama (local inference)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b"
OLLAMA_EMBED_MODEL="nomic-embed-text"

# ── GOOGLE OAUTH ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── EMAIL / SMTP ─────────────────────────────────────────────────────────────
EMAIL_FROM_ADDRESS=""
EMAIL_FROM_NAME="YouAndINotAI"
EMAIL_REPLY_TO=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_USE_SSL="false"
SMTP_USE_STARTTLS="true"

# ── TELEGRAM ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ── GITHUB ───────────────────────────────────────────────────────────────────
# GitHub Personal Access Token — for GitHub MCP plugin
GITHUB_TOKEN=""

# ── BLOCKCHAIN / WEB3 ────────────────────────────────────────────────────────
# Base network deployer private key (for smart contract deployment)
DEPLOYER_PRIVATE_KEY=""

# Basescan API key — for contract verification
BASESCAN_API_KEY=""

# ── CDN / STATIC ASSETS ──────────────────────────────────────────────────────
CDN_BASE_URL=""
CDN_ENABLED="false"

# ── MONITORING ───────────────────────────────────────────────────────────────
SENTRY_DSN=""
PROMETHEUS_PORT=8000
METRICS_API_KEY=""

# ── SECURITY ─────────────────────────────────────────────────────────────────
# Beta access codes — comma-separated list
BETA_ACCESS_CODES=""

# JWT token expiration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate limiting
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_TRUSTED_PROXIES=""

# ── SUPPORT ──────────────────────────────────────────────────────────────────
# Support operator emails — comma-separated
SUPPORT_OPERATOR_EMAILS=""

# OpenClaw support integration
SUPPORT_OPENCLAW_URL=""
SUPPORT_OPENCLAW_TIMEOUT_SECONDS=15

# Ollama support model
SUPPORT_OLLAMA_BASE_URL=""
SUPPORT_OLLAMA_MODEL="qwen2.5:7b"
SUPPORT_OLLAMA_TIMEOUT_SECONDS=10

# ── FILE UPLOADS ─────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_TYPES="image/jpeg,image/png,image/gif,image/webp,application/pdf"

# ── FRONTEND (Vite / React) ──────────────────────────────────────────────────
# Base URL for API calls from the frontend
VITE_API_URL="http://localhost:8000/api/v1"

# WebSocket URL (defaults to same origin if empty)
VITE_WEBSOCKET_URL=""

# CDN base URL for static assets (JS, CSS, images)
VITE_CDN_BASE_URL=""

# Google Client ID for frontend OAuth
VITE_GOOGLE_CLIENT_ID=""

# Multiplayer WebSocket URL
VITE_MULTIPLAYER_URL=""

# ── MISSION CONTROL DASHBOARD ────────────────────────────────────────────────
VITE_PAPERCLIP_URL="http://localhost:3100"

# ── MCP SERVER ───────────────────────────────────────────────────────────────
MCP_PORT=3100
MCP_HTTP_PORT=3100
MCP_AUTH_TOKEN=""
# Transport: stdio | http
TRANSPORT="stdio"

# ── BRAIN MCP ────────────────────────────────────────────────────────────────
BRAIN_TRANSPORT="stdio"
BRAIN_REPO_ROOT=""
BRAIN_DATA_DIR=""
BRAIN_PLATFORM_CONFIG=""
BRAIN_SESSION_TTL_MINUTES=120
BRAIN_HTTP_HOST="0.0.0.0"
BRAIN_PORT=3900
BRAIN_REQUIRE_AUTH="true"
BRAIN_HTTP_PORT=3900

# ── CLAWX GOVERNANCE DASHBOARD ───────────────────────────────────────────────
# Port for the ClawX server
CLAWX_PORT=8080
SESSION_SECRET="dev-secret-change-in-production"
ENCRYPTION_KEY=""
OWNER_OPEN_ID=""

# ── CODEX TASK SENTRY ────────────────────────────────────────────────────────
OPENCLAW_URL="http://localhost:3200"
OLLAMA_URL="http://localhost:11434"
CODEX_SENTRY_FALLBACK_CHAIN="ollama,codex"
CODEX_SENTRY_ALLOW_CODEX_FALLBACK="1"
CODEX_SENTRY_FULL_ACCESS="1"

# ── PAPERCLIP PLUGINS ───────────────────────────────────────────────────────
SQUARE_ACCESS_TOKEN=""
GITHUB_TOKEN=""

# ── CONTRACTS TESTING ───────────────────────────────────────────────────────
API_BASE_URL="http://localhost:8000"

# ── NEXT.JS (antigravity/) ──────────────────────────────────────────────────
DISABLE_HMR="false"

# ── YOUANDINOTAI FRONTEND (Next.js) ──────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME="YouAndINotAI"

# ═══════════════════════════════════════════════════════════════════════════════
# VARIABLE DESCRIPTIONS
# ═══════════════════════════════════════════════════════════════════════════════
#
# CORE / REQUIRED:
#   DATABASE_URL    — PostgreSQL connection string. All backend services use this
#                     to connect to the primary database. Must use asyncpg driver.
#   JWT_SECRET      — Secret key for signing JWT authentication tokens. MUST be
#                     ≥32 characters. App will refuse to start without this.
#   NODE_ENV        — Controls framework behavior (dev mode, optimizations, etc.)
#   APP_URL         — Canonical URL of the application for callbacks and links.
#
# SQUARE PAYMENTS:
#   SQUARE_ACCESS_TOKEN — OAuth token from Square Developer Dashboard. Required
#                         for all Square API calls (payments, bookings, etc.)
#   SQUARE_ENV           — Set to "sandbox" for testing, "production" for live.
#   SQUARE_WEBHOOK_*     — Signature keys and notification URLs for verifying
#                         incoming Square webhook events (payments, bookings).
#
# AI / LLM PROVIDERS:
#   GEMINI_API_KEY    — Google AI Studio API key for Gemini models.
#   ANTHROPIC_API_KEY — Anthropic API key for Claude models.
#   OPENAI_API_KEY    — OpenAI API key (used by CodeX integration).
#   XAI_API_KEY       — xAI API key for Grok models.
#   SONAR_API_KEY     — Perplexity API key for Sonar models.
#   OLLAMA_BASE_URL   — URL of local Ollama instance for local inference.
#
# REDIS / QDRANT:
#   REDIS_URL    — Redis connection string. Used for caching, session storage,
#                  task queues, and MCP server conversation history.
#   QDRANT_URL   — Qdrant vector database URL. Used for semantic search and
#                  memory features in the MCP server.
#
# FRONTEND:
#   VITE_API_URL        — Base URL the frontend uses for API calls. In production
#                         this should be a relative path or the production API URL.
#   VITE_CDN_BASE_URL   — When set, static assets are served from this CDN URL.
#   VITE_GOOGLE_CLIENT_ID — Google OAuth client ID for client-side sign-in.
#
# MCP SERVER:
#   MCP_PORT       — Port for the MCP server (default: 3100).
#   MCP_AUTH_TOKEN — Bearer token required for HTTP transport authentication.
#   TRANSPORT      — "stdio" for local Claude Code, "http" for remote access.
#
# CLAWX:
#   SESSION_SECRET  — Secret for ClawX session cookies. Change in production.
#   ENCRYPTION_KEY  — Key for encrypting sensitive ClawX data at rest.
#   PORT            — Port for the ClawX server (default: 8080).
#
# ═══════════════════════════════════════════════════════════════════════════════
