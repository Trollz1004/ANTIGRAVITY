# ============================================================================
# ANTIGRAVITY — MASTER ENVIRONMENT TEMPLATE
# All 67 keys across every service. Values are placeholders only.
# Copy to .env and fill in real values. NEVER commit .env to git.
# This file IS committed — it's the authoritative key list / krakken backup.
# ============================================================================

# ----------------------------------------------------------------------------
# ANTHROPIC / CLAUDE
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_ADMIN_KEY=sk-ant-admin-your-key-here

# ----------------------------------------------------------------------------
# GOOGLE / GEMINI / GCP
# ----------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
GCP_PROJECT_ID=ai-collab4kids
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ----------------------------------------------------------------------------
# CLOUDFLARE
# ----------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CF_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ADMIN_TOKEN=your-cloudflare-admin-token

# ----------------------------------------------------------------------------
# GITHUB
# ----------------------------------------------------------------------------
# NOTE: GitHub PAT lives in Windows Credential Manager, NOT here.
# Only add if running in CI or non-Windows environments.
GITHUB_PAT=ghp_your-token-here

# ----------------------------------------------------------------------------
# SQUARE PAYMENTS
# ----------------------------------------------------------------------------
SQUARE_ACCESS_TOKEN=EAAAl_your-square-token
SQUARE_LOCATION_ID=LY5GN09F5AN83
SQUARE_PAYMENT_WEBHOOK_SIGNATURE_KEY=your-webhook-sig-key
SQUARE_PAYMENT_WEBHOOK_NOTIFICATION_URL=https://youandinotai.com/api/v1/webhooks/square/payment
SQUARE_BOOKING_WEBHOOK_SIGNATURE_KEY=your-booking-sig-key
SQUARE_BOOKING_WEBHOOK_NOTIFICATION_URL=https://youandinotai.com/api/v1/webhooks/square/booking
SQUARE_WEBHOOK_SIGNATURE_KEY=your-general-webhook-sig-key
SQUARE_WEBHOOK_NOTIFICATION_URL=https://youandinotai.com/api/v1/webhooks/square

# ----------------------------------------------------------------------------
# EBAY
# ----------------------------------------------------------------------------
EBAY_APP_ID=your-ebay-app-id
EBAY_CERT_ID=your-ebay-cert-id
EBAY_DEV_ID=your-ebay-dev-id
EBAY_OAUTH_TOKEN=your-ebay-oauth-token

# ----------------------------------------------------------------------------
# EMAIL / SMTP
# ----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=joshlcoleman@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM_ADDRESS=joshlcoleman@gmail.com
EMAIL_REPLY_TO=joshlcoleman@gmail.com
ALERT_EMAIL_ENABLED=true
ALERT_EMAIL_FROM=joshlcoleman@gmail.com
ALERT_EMAIL_TO=joshlcoleman@gmail.com
SMTP_SERVER=smtp.gmail.com

# ----------------------------------------------------------------------------
# TELEGRAM
# ----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ----------------------------------------------------------------------------
# APIFY (web scraping / trend research)
# ----------------------------------------------------------------------------
APIPY_TOKEN=apify_api_your-token-here

# ----------------------------------------------------------------------------
# BLOCKCHAIN / BASESCAN
# ----------------------------------------------------------------------------
BASESCAN_API_KEY=your-basescan-api-key

# ----------------------------------------------------------------------------
# JWT / SECURITY
# ----------------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
METRICS_API_KEY=your-metrics-api-key

# ----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://paperclip:paperclip@postgres:5432/paperclip
POSTGRES_USER=paperclip
POSTGRES_PASSWORD=paperclip
POSTGRES_DB=paperclip

# ----------------------------------------------------------------------------
# LOCAL OLLAMA
# ----------------------------------------------------------------------------
OLLAMA_HOST=192.168.0.8:11434
OLLAMA_MODEL=gemma4:31b

# ----------------------------------------------------------------------------
# LITELLM PROXY
# ----------------------------------------------------------------------------
LITELLM_CONFIG_PATH=/app/config.yaml
LITELLM_LOG_LEVEL=INFO
LITELLM_PORT=11436

# ----------------------------------------------------------------------------
# PAPERCLIP / OPENCLAW AGENT CONFIG
# ----------------------------------------------------------------------------
PAPERCLIP_WORKSPACE=/workspace/paperclip
WORKING_DIR=/workspace/antigravity
NODE_ENV=production
OPENAI_API_BASE=http://litellm-proxy:8000/v1
OPENAI_MODEL=gemma4:31b
OPENAI_API_KEY=sk-fakekey123
PAPERCLIP_API_URL=http://localhost:3200
PAPERCLIP_API_KEY=your-paperclip-api-key
PAPERCLIP_COMPANY_ID=your-company-id

# ----------------------------------------------------------------------------
# CLOUD PROVIDERS (optional — only if routing to cloud backends)
# ----------------------------------------------------------------------------
TOGETHER_API_KEY=sk-your-together-api-key-here
REPLICATE_API_TOKEN=your-replicate-token-here
DAILY_API_KEY=your-daily-api-key
KIMI_API_KEY=your-kimi-api-key

# ----------------------------------------------------------------------------
# REDIS (caching)
# ----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CACHE_ENABLED=true

# ----------------------------------------------------------------------------
# RATE LIMITING
# ----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ----------------------------------------------------------------------------
# AGENT SCALING
# ----------------------------------------------------------------------------
MAX_CONCURRENT_AGENTS=10
AGENT_TIMEOUT_SECONDS=120
AGENT_RETRY_COUNT=3

# ----------------------------------------------------------------------------
# LOGGING
# ----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
