      </section>
      <aside
        class="space-y-4"
      >
        <section
          class="rounded-md border border-slate-800 bg-slate-950/70 p-4 shadow-sm"
        >
          <div
            class="mb-3 flex items-center justify-between gap-3"
          >
            <h2
              class="flex items-center gap-2 text-sm font-semibold text-slate-100"
            >
              <span
                class="text-cyan-300"
              >
                <svg
                  class="lucide lucide-scroll-text"
                  fill="none"
                  height="16"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  width="16"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M15 12h-5"
                  />
                  <path
                    d="M15 8h-5"
                  />
                  <path
                    d="M19 17V5a2 2 0 0 0-2-2H4"
                  />
                  <path
                    d="M8 21h12a2 2 0 0 0 2-2v-1a1 1 0 0 0-1-1H11a1 1 0 0 0-1 1v1a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v2a1 1 0 0 0 1 1h3"
                  />
                </svg>
              </span>
              Run Logs
            </h2>
            <button
              class="inline-flex min-h-9 items-center justify-center gap-2 rounded-md border px-3 text-xs font-semibold transition disabled:cursor-not-allowed disabled:opacity-40 border-slate-700 bg-slate-900 text-slate-200 hover:border-cyan-400/60"
              type="button"
            >
              <svg
                class="lucide lucide-refresh-cw"
                fill="none"
                height="14"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="14"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"
                />
                <path
                  d="M21 3v5h-5"
                />
                <path
                  d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"
                />
                <path
                  d="M8 16H3v5"
                />
              </svg>
              Reload
            </button>
          </div>
          <div
            class="space-y-2"
            data-testid="runs-list"
          >
            <div
              class="rounded-md border border-slate-800 bg-slate-900 p-3 text-sm text-slate-400"
            >
              No operations have run from this API process yet.
            </div>
          </div>
          <pre
            class="mt-3 max-h-72 overflow-auto whitespace-pre-wrap rounded-md border border-slate-800 bg-slate-950 p-3 text-xs leading-5 text-slate-300"
            data-testid="run-output"
          >
            Run an operation to see captured output here.
          </pre>
        </section>
        <section
          class="rounded-md border border-slate-800 bg-slate-950/70 p-4 shadow-sm"
        >
          <div
            class="mb-3 flex items-center justify-between gap-3"
          >
            <h2
              class="flex items-center gap-2 text-sm font-semibold text-slate-100"
            >
              <span
                class="text-cyan-300"
              >
                <svg
                  class="lucide lucide-file-text"
                  fill="none"
                  height="16"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  width="16"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"
                  />
                  <path
                    d="M14 2v4a2 2 0 0 0 2 2h4"
                  />
                  <path
                    d="M10 9H8"
                  />
                  <path
                    d="M16 13H8"
                  />
                  <path
                    d="M16 17H8"
                  />
                </svg>
              </span>
              Runbooks
            </h2>
            <button
              class="inline-flex min-h-9 items-center justify-center gap-2 rounded-md border px-3 text-xs font-semibold transition disabled:cursor-not-allowed disabled:opacity-40 border-slate-700 bg-slate-900 text-slate-200 hover:border-cyan-400/60"
              type="button"
            >
              <svg
                class="lucide lucide-refresh-cw"
                fill="none"
                height="14"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="14"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"
                />
                <path
                  d="M21 3v5h-5"
                />
                <path
                  d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"
                />
                <path
                  d="M8 16H3v5"
                />
              </svg>
              Reload
            </button>
          </div>
          <div
            class="max-h-64 space-y-2 overflow-auto pr-1"
            data-testid="runbook-list"
          />
          <pre
            class="mt-3 max-h-80 overflow-auto whitespace-pre-wrap rounded-md border border-slate-800 bg-slate-950 p-3 text-xs leading-5 text-slate-300"
            data-testid="runbook-content"
          >
            Select a runbook to read the current handoff or incident notes.
          </pre>
        </section>
        <section
          class="rounded-md border border-slate-800 bg-slate-950/70 p-4 shadow-sm"
        >
          <div
            class="mb-3 flex items-center justify-between gap-3"
          >
            <h2
              class="flex items-center gap-2 text-sm font-semibold text-slate-100"
            >
              <span
                class="text-cyan-300"
              >
                <svg
                  class="lucide lucide-list-checks"
                  fill="none"
                  height="16"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  width="16"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="m3 17 2 2 4-4"
                  />
                  <path
                    d="m3 7 2 2 4-4"
                  />
                  <path
                    d="M13 6h8"
                  />
                  <path
                    d="M13 12h8"
                  />
                  <path
                    d="M13 18h8"
                  />
                </svg>
              </span>
              Recent Tasks
            </h2>
            <button
              class="inline-flex min-h-9 items-center justify-center gap-2 rounded-md border px-3 text-xs font-semibold transition disabled:cursor-not-allowed disabled:opacity-40 border-slate-700 bg-slate-900 text-slate-200 hover:border-cyan-400/60"
              type="button"
            >
              <svg
                class="lucide lucide-refresh-cw"
                fill="none"
                height="14"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="14"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"
                />
                <path
                  d="M21 3v5h-5"
                />
                <path
                  d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"
                />
                <path
                  d="M8 16H3v5"
                />
              </svg>
              Refresh
            </button>
          </div>
          <div
            class="space-y-2"
            data-testid="tasks-list"
          >
            <div
              class="rounded-md border border-slate-800 bg-slate-900 p-3 text-sm text-slate-400"
            >
              No queued tasks yet.
            </div>
          </div>
        </section>
        <section
          class="rounded-md border border-slate-800 bg-slate-950/70 p-4 shadow-sm"
        >
          <div
            class="mb-3 flex items-center justify-between gap-3"
          >
            <h2
              class="flex items-center gap-2 text-sm font-semibold text-slate-100"
            >
              <span
                class="text-cyan-300"
              >
                <svg
                  class="lucide lucide-shield-check"
                  fill="none"
                  height="16"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  width="16"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"
                  />
                  <path
                    d="m9 12 2 2 4-4"
                  />
                </svg>
              </span>
              Stack Notes
            </h2>
          </div>
          <div
            class="space-y-2 text-sm text-slate-300"
          >
            <div
              class="flex items-center gap-2"
            >
              <svg
                class="lucide lucide-server text-cyan-300"
                fill="none"
                height="14"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="14"
                xmlns="http://www.w3.org/2000/svg"
              >
                <rect
                  height="8"
                  rx="2"
                  ry="2"
                  width="20"
                  x="2"
                  y="2"
                />
                <rect
                  height="8"
                  rx="2"
                  ry="2"
                  width="20"
                  x="2"
                  y="14"
                />
                <line
                  x1="6"
                  x2="6.01"
                  y1="6"
                  y2="6"
                />
                <line
                  x1="6"
                  x2="6.01"
                  y1="18"
                  y2="18"
                />
              </svg>
              Mission Control API serves UI and backend on :8787.
            </div>
            <div
              class="flex items-center gap-2"
            >
              <svg
                class="lucide lucide-git-branch text-cyan-300"
                fill="none"
                height="14"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="14"
                xmlns="http://www.w3.org/2000/svg"
              >
                <line
                  x1="6"
                  x2="6"
                  y1="3"
                  y2="15"
                />
                <circle
                  cx="18"
                  cy="6"
                  r="3"
                />
                <circle
                  cx="6"
                  cy="18"
                  r="3"
                />
                <path
                  d="M18 9a9 9 0 0 1-9 9"
                />
              </svg>
              Repo drift is visible above before any push decision.
            </div>
            <div
              class="flex items-center gap-2"
            >
              <svg
                class="lucide lucide-code-xml text-cyan-300"
                fill="none"
                height="14"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="14"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="m18 16 4-4-4-4"
                />
                <path
                  d="m6 8-4 4 4 4"
                />
                <path
                  d="m14.5 4-5 16"
                />
              </svg>
              Browser actions copy commands or queue tasks; they do not silently run shell commands.
            </div>
            <div
              class="flex items-center gap-2"
            >
              <svg
                class="lucide lucide-clipboard text-cyan-300"
                fill="none"
                height="14"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="14"
                xmlns="http://www.w3.org/2000/svg"
              >
                <rect
                  height="4"
                  rx="1"
                  ry="1"
                  width="8"
                  x="8"
                  y="2"
                />
                <path
                  d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"
                />
              </svg>
              Runbooks are read from E:/ANTIGRAVITY\\briefings\\runbooks.
            </div>
          </div>
        </section>
      </aside>
    </main>
  </div>
</div>
`;
