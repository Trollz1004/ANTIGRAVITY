# Stage 1: Build the React app
FROM node:20-alpine as builder

WORKDIR /app

# Copy package.json and yarn.lock to install dependencies
COPY package.json yarn.lock ./frontend/mission-control

# Install dependencies
RUN cd ./frontend/mission-control && yarn install --frozen-lockfile

# Copy the rest of the app
COPY ./apps/mission-control ./frontend/mission-control

# Build args for VITE_API_URL
ARG VITE_API_URL

# Set environment variables for the build
ENV VITE_API_URL=$VITE_API_URL
ENV NODE_ENV=production

# Build the app
RUN cd ./frontend/mission-control && yarn build

# Stage 2: Serve the app with Nginx (or a simple HTTP server)
FROM nginx:alpine

# Copy custom Nginx configuration (if any, for now, a default will do)
# COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy the built app from the builder stage
COPY --from=builder /app/frontend/mission-control/dist /usr/share/nginx/html

# Expose port 80 for Nginx
EXPOSE 80

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]
