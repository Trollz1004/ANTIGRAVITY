generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  role          Role      @default(ADMIN)
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  auditLogs     AuditLog[]
  connectors    Connector[]
  organizations OrganizationMember[]

  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model Connector {
  id          String       @id @default(cuid())
  userId      String
  name        String
  type        ConnectorType
  config      Json
  isEnabled   Boolean      @default(true)
  lastSyncAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncLogs    ConnectorSyncLog[]

  @@index([userId])
  @@map("connectors")
}

model ConnectorSyncLog {
  id           String   @id @default(cuid())
  connectorId  String
  status       SyncStatus
  message      String?
  recordsCount Int?
  startedAt    DateTime @default(now())
  completedAt  DateTime?

  connector    Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([connectorId])
  @@map("connector_sync_logs")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  type        OrgType
  metadata    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members           OrganizationMember[]
  listings          Listing[]
  verificationRequests VerificationRequest[]
  buyerDeals    Deal[] @relation("BuyerDeals")
  sellerDeals   Deal[] @relation("SellerDeals")

  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           OrgRole  @default(MEMBER)
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("organization_members")
}

model Listing {
  id          String        @id @default(cuid())
  orgId       String
  type        ListingType
  title       String
  description String
  status      ListingStatus @default(DRAFT)
  pricing     Json
  metadata    Json
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  publishedAt DateTime?

  org         Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deals       Deal[]

  @@index([orgId])
  @@index([type, status])
  @@index([createdAt])
  @@map("listings")
}

model Deal {
  id           String      @id @default(cuid())
  listingId    String
  buyerOrgId   String
  sellerOrgId  String
  status       DealStatus  @default(NEGOTIATION)
  agreedPrice  Decimal?
  terms        Json
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  completedAt  DateTime?

  listing      Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerOrg     Organization @relation("BuyerDeals", fields: [buyerOrgId], references: [id], onDelete: Cascade)
  sellerOrg    Organization @relation("SellerDeals", fields: [sellerOrgId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([buyerOrgId])
  @@index([sellerOrgId])
  @@index([status])
  @@index([createdAt])
  @@map("deals")
}

model Message {
  id        String   @id @default(cuid())
  dealId    String
  senderId  String
  content   String
  metadata  Json?
  createdAt DateTime @default(now())

  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([createdAt])
  @@map("messages")
}

// Verification / Trust
model VerificationRequest {
  id           String   @id @default(cuid())
  orgId        String
  status       VerificationStatus @default(PENDING)
  type         VerificationType
  documents    Json
  notes        String?
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([status])
  @@map("verification_requests")
}

// Enums
enum Role {
  ADMIN
  OPERATOR
  VIEWER
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum ConnectorType {
  OLLAMA
  EMAIL
  WEBHOOK
  DATABASE
  API
}

enum SyncStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ListingType {
  SERVICE
  PROJECT
  REFERRAL
  BUSINESS_SALE
  ASSET_SALE
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  SOLD
}

enum DealStatus {
  NEGOTIATION
  CONTRACT_SIGNED
  COMPLETED
  ARCHIVED
}

enum OrgType {
  COMPANY
  for-profit
  SOLE_PROPRIETOR
  PARTNERSHIP
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum VerificationType {
  BUSINESS_REGISTRATION
  TAX_ID
  PROOF_OF_FUNDS
  IDENTITY
  DOMAIN_OWNERSHIP
  FINANCIAL_STATEMENTS
}