# ═══════════════════════════════════════════════════════════════════════════════
# SYSTEMD SERVICE: DateApp Docker Stack
# Location: /etc/systemd/system/dateapp.service
# Author: ENIGMA
# Enables: sudo systemctl enable dateapp
# ═══════════════════════════════════════════════════════════════════════════════

[Unit]
Description=YouAndINotAI Dating Platform (Docker Compose)
Documentation=https://youandinotai.com
After=network-online.target docker.service
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/dateapp
Environment="PATH=/usr/local/bin:/usr/bin:/bin"

# Start all containers
ExecStart=/usr/bin/docker compose up -d --remove-orphans

# Stop all containers gracefully
ExecStop=/usr/bin/docker compose down

# Reload (restart) all containers
ExecReload=/usr/bin/docker compose restart

# Ensure containers start within 5 minutes
TimeoutStartSec=300
TimeoutStopSec=120

# Restart policy
Restart=on-failure
RestartSec=30

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dateapp

[Install]
WantedBy=multi-user.target
