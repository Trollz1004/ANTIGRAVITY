# ============================================================================
# ANTIGRAVITY — MASTER ENVIRONMENT TEMPLATE (STAGING)
# All 67 keys across every service. Values are placeholders only.
# Copy to .env.staging and fill in real values. NEVER commit .env.staging to git.
# This file IS committed — it's the authoritative key list / krakken backup.
# ============================================================================

# ----------------------------------------------------------------------------
# ANTHROPIC / CLAUDE
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant...here-staging
ANTHROPIC_ADMIN_KEY=sk-ant...here-staging

# ----------------------------------------------------------------------------
# GOOGLE / GEMINI / GCP
# ----------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here-staging
GCP_PROJECT_ID=ai-collab4kids-staging
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-staging.json

# ----------------------------------------------------------------------------
# CLOUDFLARE
# ----------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id-staging
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token-staging
CF_API_TOKEN=your-cloudflare-api-token-staging
CLOUDFLARE_ADMIN_TOKEN=your-cloudflare-admin-token-staging

# ----------------------------------------------------------------------------
# GITHUB
# ----------------------------------------------------------------------------
# NOTE: GitHub PAT lives in Windows Credential Manager, NOT here.
# Only add if running in CI or non-Windows environments.
GITHUB_PAT=ghp_your-token-here-staging

# ----------------------------------------------------------------------------
# SQUARE PAYMENTS
# ----------------------------------------------------------------------------
SQUARE_ACCESS_TOKEN=EAAAl_your-square-token-staging
SQUARE_LOCATION_ID=LY5GN09F5AN83-staging
SQUARE_PAYMENT_WEBHOOK_SIGNATURE_KEY=your-webhook-sig-key-staging
SQUARE_PAYMENT_WEBHOOK_NOTIFICATION_URL=https://staging.youandinotai.com/api/v1/webhooks/square/payment
SQUARE_BOOKING_WEBHOOK_SIGNATURE_KEY=your-booking-sig-key-staging
SQUARE_BOOKING_WEBHOOK_NOTIFICATION_URL=https://staging.youandinotai.com/api/v1/webhooks/square/booking
SQUARE_WEBHOOK_SIGNATURE_KEY=your-general-webhook-sig-key-staging
SQUARE_WEBHOOK_NOTIFICATION_URL=https://staging.youandinotai.com/api/v1/webhooks/square

# ----------------------------------------------------------------------------
# EBAY
# ----------------------------------------------------------------------------
EBAY_APP_ID=your-ebay-app-id-staging
EBAY_CERT_ID=your-ebay-cert-id-staging
EBAY_DEV_ID=your-ebay-dev-id-staging
EBAY_OAUTH_TOKEN=your-ebay-oauth-token-staging

# ----------------------------------------------------------------------------
# EMAIL / SMTP
# ----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=joshlcoleman+staging@gmail.com
SMTP_PASSWORD=your-app-password-staging
EMAIL_FROM_ADDRESS=joshlcoleman+staging@gmail.com
EMAIL_REPLY_TO=joshlcoleman+staging@gmail.com
ALERT_EMAIL_ENABLED=true
ALERT_EMAIL_FROM=joshlcoleman+staging@gmail.com
ALERT_EMAIL_TO=joshlcoleman+staging@gmail.com
SMTP_SERVER=smtp.gmail.com

# ----------------------------------------------------------------------------
# TELEGRAM
# ----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-staging

# ----------------------------------------------------------------------------
# APIFY (web scraping / trend research)
# ----------------------------------------------------------------------------
APIPY_TOKEN=apify_api_your-token-here-staging

# ----------------------------------------------------------------------------
# BLOCKCHAIN / BASESCAN
# ----------------------------------------------------------------------------
BASESCAN_API_KEY=your-basescan-api-key-staging

# ----------------------------------------------------------------------------
# JWT / SECURITY
# ----------------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-staging
METRICS_API_KEY=your-metrics-api-key-staging

# ----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://paperclip_staging:paperclip_staging@postgres-staging:5432/paperclip_staging
POSTGRES_USER=paperclip_staging
POSTGRES_PASSWORD=paperclip_staging
POSTGRES_DB=paperclip_staging

# ----------------------------------------------------------------------------
# LOCAL OLLAMA
# ----------------------------------------------------------------------------
OLLAMA_HOST=192.168.0.8:11434 # Can be same for staging, or a dedicated staging instance
OLLAMA_MODEL=gemma4:31b # Can be same for staging, or a dedicated staging model

# ----------------------------------------------------------------------------
# LITELLM PROXY
# ----------------------------------------------------------------------------
LITELLM_CONFIG_PATH=/app/config.yaml # Assuming config for litellm remains the same
LITELLM_LOG_LEVEL=INFO
LITELLM_PORT=11436 # Can be same for staging

# ----------------------------------------------------------------------------
# PAPERCLIP / OPENCLAW AGENT CONFIG
# ----------------------------------------------------------------------------
PAPERCLIP_WORKSPACE=/workspace/paperclip_staging
WORKING_DIR=/workspace/antigravity_staging
NODE_ENV=staging
ENVIRONMENT=staging
OPENAI_API_BASE=http://litellm-proxy:8000/v1 # This needs to point to the correct litellm for staging, which is not defined in this docker-compose
OPENAI_MODEL=gemma4:31b
OPENAI_API_KEY=***
PAPERCLIP_API_URL=http://localhost:3100 # Paperclip on localhost:3100 as per context
PAPERCLIP_API_KEY=your-paperclip-api-key-staging
PAPERCLIP_COMPANY_ID=your-company-id-staging

# ----------------------------------------------------------------------------
# CLOUD PROVIDERS (optional — only if routing to cloud backends)
# ----------------------------------------------------------------------------
TOGETHER_API_KEY=sk-you...here-staging
REPLICATE_API_TOKEN=your-replicate-token-here-staging
DAILY_API_KEY=your-daily-api-key-staging
KIMI_API_KEY=your-kimi-api-key-staging

# ----------------------------------------------------------------------------
# REDIS (caching)
# ----------------------------------------------------------------------------
REDIS_HOST=redis-staging
REDIS_PORT=6379
REDIS_CACHE_ENABLED=true

# ----------------------------------------------------------------------------
# RATE LIMITING
# ----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ----------------------------------------------------------------------------
# AGENT SCALING
# ----------------------------------------------------------------------------
MAX_CONCURRENT_AGENTS=10
AGENT_TIMEOUT_SECONDS=120
AGENT_RETRY_COUNT=3

# ----------------------------------------------------------------------------
# LOGGING
# ----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
