{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "decks/**",
              "ui_kits/mission-control/**",
              "ui_kits/youandinotai/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color membership record via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing membership record via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Inter, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|size|verified|online|ring|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, name, size, verified, online, ring, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|solid|icon|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, solid, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:cyan|pink|rose|gold|slate|success)$/]",
        "message": "<Badge> tone must be one of 'cyan' | 'pink' | 'rose' | 'gold' | 'slate' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|iconRight|disabled|type|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, iconRight, disabled, type, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:neon|pink|outline|ghost)$/]",
        "message": "<Button> variant must be one of 'neon' | 'pink' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|radius|pad|glow|hoverLift|as|style|key|ref|className|style|children)$/]",
        "message": "<GlassPanel> doesn't accept that prop. Declared props: children, radius, pad, glow, hoverLift, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassPanel'] > JSXAttribute[name.name='radius'] > Literal[value!=/^(?:sm|card|panel|hero)$/]",
        "message": "<GlassPanel> radius must be one of 'sm' | 'card' | 'panel' | 'hero'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassPanel'] > JSXAttribute[name.name='pad'] > Literal[value!=/^(?:none|sm|card|panel|hero)$/]",
        "message": "<GlassPanel> pad must be one of 'none' | 'sm' | 'card' | 'panel' | 'hero'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|type|placeholder|value|onChange|hint|id|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, icon, type, placeholder, value, onChange, hint, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MonoLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|color|dot|size|style|key|ref|className|style|children)$/]",
        "message": "<MonoLabel> doesn't accept that prop. Declared props: children, color, dot, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|style|key|ref|className|style|children)$/]",
        "message": "<ProductChip> doesn't accept that prop. Declared props: children, tone, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductChip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:cyan|pink|rose|success|purple|gold|amber)$/]",
        "message": "<ProductChip> tone must be one of 'cyan' | 'pink' | 'rose' | 'success' | 'purple' | 'gold' | 'amber'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|note|accent|icon|live|style|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: label, value, note, accent, icon, live, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:cyan|pink|gold|success|slate)$/]",
        "message": "<StatCard> accent must be one of 'cyan' | 'pink' | 'gold' | 'success' | 'slate'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|label|style|key|ref|className|style|children)$/]",
        "message": "<StatusPill> doesn't accept that prop. Declared props: status, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:live|active|pending|paused|failed|offline)$/]",
        "message": "<StatusPill> status must be one of 'live' | 'active' | 'pending' | 'paused' | 'failed' | 'offline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SurfaceLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|status|description|href|icon|statusTone|style|key|ref|className|style|children)$/]",
        "message": "<SurfaceLink> doesn't accept that prop. Declared props: name, status, description, href, icon, statusTone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SurfaceLink'] > JSXAttribute[name.name='statusTone'] > Literal[value!=/^(?:cyan|pink|success|paused|gold|slate)$/]",
        "message": "<SurfaceLink> statusTone must be one of 'cyan' | 'pink' | 'success' | 'paused' | 'gold' | 'slate'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
