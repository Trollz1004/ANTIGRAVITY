#!/usr/bin/env bash
set -euo pipefail

# Blocks commits that include likely secrets.
# This checks staged content only.

if ! command -v perl >/dev/null 2>&1; then
  echo "ERROR: perl is required for secret scanning in pre-commit hook."
  exit 1
fi

staged_patch="$(git diff --cached -U0 -- .)"
if [[ -z "${staged_patch}" ]]; then
  exit 0
fi

# High-confidence secret patterns.
regex='
ghp_[A-Za-z0-9]{30,}|
github_pat_[A-Za-z0-9_]{40,}|
sk_live_[A-Za-z0-9]{16,}|
AKIA[0-9A-Z]{16}|
-----BEGIN (RSA|EC|OPENSSH|DSA) PRIVATE KEY-----|
xox[baprs]-[A-Za-z0-9-]{10,}|
AIza[0-9A-Za-z_\-]{20,}|
ANTHROPIC_API_KEY\s*=\s*[A-Za-z0-9_-]{20,}|
TELEGRAM_BOT_TOKEN\s*=\s*[0-9]{6,}:[A-Za-z0-9_-]{20,}|
GITHUB_PERSONAL_ACCESS_TOKEN\s*=\s*(?!["'\'']?\$)(?!["'\'']?\{)[A-Za-z0-9_]{20,}
'

if printf '%s' "${staged_patch}" | perl -0777 -ne "exit((/\b(?:${regex})\b/is) ? 1 : 0)"; then
  exit 0
fi

echo "ERROR: Commit blocked by secret scanner."
echo "A potential secret/token/private key pattern was found in staged changes."
echo "Action: remove/redact secret and use env/vault references instead."
exit 1
