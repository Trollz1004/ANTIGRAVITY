{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dream.npc.trigger.v1",
  "title": "DREAM Live-NPC Trigger Envelope",
  "type": "object",
  "required": ["schema", "trigger_id", "type", "ts", "region_id", "source", "payload"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "dream.npc.trigger.v1" },
    "trigger_id": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": [
        "npc.approached",
        "npc.spoken_to",
        "npc.witnessed",
        "npc.affected",
        "world.tick",
        "npc.idle_heartbeat",
        "npc.quest_signal"
      ]
    },
    "ts": { "type": "string", "format": "date-time" },
    "region_id": { "type": "string", "minLength": 1 },
    "npc_id": { "type": "string" },
    "source": { "type": "string", "enum": ["game_server", "orchestrator", "sim"] },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "npc.approached",
              "npc.spoken_to",
              "npc.witnessed",
              "npc.affected",
              "npc.idle_heartbeat",
              "npc.quest_signal"
            ]
          }
        }
      },
      "then": { "required": ["npc_id"] }
    }
  ]
}
