# ── Mission Control: Agency Swarm v5 — server config ─────────────────────────
# Copy to server/.env (or project root). Secrets live in env ONLY — never in git.

PORT=3151

# ── OMNIROUTE ───────────────────────────────────────────────────────────────
# Provider priority order (comma-separated). First configured + healthy wins.
# Available adapters: openai_compat | ollama
# Cloud routing stays first. Keep ollama only as an explicit fail-safe.
OMNI_PROVIDER_ORDER=openai_compat,ollama

# Adapter: authenticated OmniRoute OpenAI-compatible cloud gateway.
# Base URL with or without trailing /v1 — both accepted.
OPENAI_COMPAT_BASE_URL=http://localhost:20129/v1
OPENAI_COMPAT_API_KEY=
OMNIROUTE_API_KEY=
OPENAI_COMPAT_MODEL_SPEED=
OPENAI_COMPAT_MODEL_REASONING=

# Adapter: Ollama (local models)
OLLAMA_BASE_URL=
OLLAMA_MODEL_SPEED=
OLLAMA_MODEL_REASONING=

# ── OPERATIONAL BRIDGES ─────────────────────────────────────────────────────
# Hermes must be explicitly configured before prompt forwarding is enabled.
HERMES_PORT=9119
HERMES_BRIDGE_URL=
HERMES_HEALTH_URL=
HERMES_EXPECTED_SERVICE=hermes
OPENCLAW_PORT=18789
OPENCLAW_BRIDGE_URL=
OPENCLAW_HEALTH_URL=
OPENCLAW_EXPECTED_SERVICE=openclaw
# Identity-checked service probes. Configure only documented status endpoints.
OMNIROUTE_HEALTH_URL=http://127.0.0.1:20128/api/v1
# Leave blank: the gateway's /api/v1 self-identifies via its OpenAI-list shape
# (object=list). Set only if the gateway gains an explicit service field.
OMNIROUTE_EXPECTED_SERVICE=
# Optional endpoint used only to report the separate omniroute --mcp process.
OMNIROUTE_MCP_STATUS_URL=
OMNIROUTE_MCP_EXPECTED_SERVICE=omniroute-mcp
# Date App identity probe: response must contain status=ok or status=degraded.
DATE_APP_HEALTH_URL=http://192.168.0.15:3200/health
# Optional 1min.ai translation shim identity probe. Leave blank until the loopback
# shim is intentionally started; then set http://127.0.0.1:20130/health.
ONEMIN_SHIM_STATUS_URL=

# ── SWARM ENGINE ──────────────────────────────────────────────────────────────
SWARM_CONCURRENCY=3
SWARM_MAX_TOKENS=4096

# ── OPTIONAL: Agent Hub bridge (mirror tasks to an external AgentTask API) ────
# Fail-closed: bridge is fully disabled unless BOTH values are set.
AGENT_HUB_URL=
AGENT_HUB_API_KEY=
