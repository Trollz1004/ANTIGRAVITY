{
  "$schema": "https://antigravity.local/schemas/scaling-rules/v1",
  "version": "1.0.0",
  "description": "Auto-scaling rules for the ANTIGRAVITY platform (OPU-62)",
  "last_updated": "2026-05-18",

  "global": {
    "evaluation_interval_seconds": 30,
    "max_scale_up_events_per_hour": 10,
    "max_scale_down_events_per_hour": 5,
    "cooldown_override": {
      "emergency": {
        "enabled": true,
        "cooldown_seconds": 60
      }
    }
  },

  "services": {
    "web": {
      "description": "React frontend service",
      "min_replicas": 2,
      "max_replicas": 10,
      "scaling_rules": [
        {
          "name": "cpu_scale_up",
          "metric": "cpu_utilization_percent",
          "condition": "avg",
          "threshold": 70,
          "comparison": "greater_than",
          "duration_seconds": 120,
          "action": "scale_up",
          "step": 1,
          "cooldown_seconds": 120
        },
        {
          "name": "cpu_scale_down",
          "metric": "cpu_utilization_percent",
          "condition": "avg",
          "threshold": 30,
          "comparison": "less_than",
          "duration_seconds": 300,
          "action": "scale_down",
          "step": 1,
          "cooldown_seconds": 300
        },
        {
          "name": "memory_scale_up",
          "metric": "memory_utilization_percent",
          "condition": "avg",
          "threshold": 80,
          "comparison": "greater_than",
          "duration_seconds": 120,
          "action": "scale_up",
          "step": 1,
          "cooldown_seconds": 120
        },
        {
          "name": "memory_scale_down",
          "metric": "memory_utilization_percent",
          "condition": "avg",
          "threshold": 40,
          "comparison": "less_than",
          "duration_seconds": 600,
          "action": "scale_down",
          "step": 1,
          "cooldown_seconds": 600
        },
        {
          "name": "request_rate_scale_up",
          "metric": "requests_per_second",
          "condition": "per_replica_avg",
          "threshold": 800,
          "comparison": "greater_than",
          "duration_seconds": 120,
          "action": "scale_up",
          "step": 2,
          "cooldown_seconds": 180
        },
        {
          "name": "request_rate_scale_down",
          "metric": "requests_per_second",
          "condition": "per_replica_avg",
          "threshold": 150,
          "comparison": "less_than",
          "duration_seconds": 600,
          "action": "scale_down",
          "step": 1,
          "cooldown_seconds": 600
        },
        {
          "name": "emergency_cpu",
          "metric": "cpu_utilization_percent",
          "condition": "max",
          "threshold": 90,
          "comparison": "greater_than",
          "duration_seconds": 60,
          "action": "scale_up",
          "step": 3,
          "cooldown_seconds": 60,
          "priority": "emergency"
        }
      ]
    },

    "api": {
      "description": "FastAPI backend service",
      "min_replicas": 2,
      "max_replicas": 20,
      "scaling_rules": [
        {
          "name": "cpu_scale_up",
          "metric": "cpu_utilization_percent",
          "condition": "avg",
          "threshold": 70,
          "comparison": "greater_than",
          "duration_seconds": 120,
          "action": "scale_up",
          "step": 2,
          "cooldown_seconds": 120
        },
        {
          "name": "cpu_scale_down",
          "metric": "cpu_utilization_percent",
          "condition": "avg",
          "threshold": 30,
          "comparison": "less_than",
          "duration_seconds": 300,
          "action": "scale_down",
          "step": 1,
          "cooldown_seconds": 300
        },
        {
          "name": "memory_scale_up",
          "metric": "memory_utilization_percent",
          "condition": "avg",
          "threshold": 80,
          "comparison": "greater_than",
          "duration_seconds": 120,
          "action": "scale_up",
          "step": 2,
          "cooldown_seconds": 120
        },
        {
          "name": "memory_scale_down",
          "metric": "memory_utilization_percent",
          "condition": "avg",
          "threshold": 40,
          "comparison": "less_than",
          "duration_seconds": 600,
          "action": "scale_down",
          "step": 1,
          "cooldown_seconds": 600
        },
        {
          "name": "request_rate_scale_up",
          "metric": "requests_per_second",
          "condition": "per_replica_avg",
          "threshold": 1000,
          "comparison": "greater_than",
          "duration_seconds": 120,
          "action": "scale_up",
          "step": 2,
          "cooldown_seconds": 180
        },
        {
          "name": "request_rate_scale_down",
          "metric": "requests_per_second",
          "condition": "per_replica_avg",
          "threshold": 200,
          "comparison": "less_than",
          "duration_seconds": 600,
          "action": "scale_down",
          "step": 1,
          "cooldown_seconds": 600
        },
        {
          "name": "latency_scale_up",
          "metric": "p95_latency_ms",
          "condition": "avg",
          "threshold": 500,
          "comparison": "greater_than",
          "duration_seconds": 120,
          "action": "scale_up",
          "step": 2,
          "cooldown_seconds": 180
        },
        {
          "name": "error_rate_emergency",
          "metric": "error_rate_5xx_percent",
          "condition": "avg",
          "threshold": 2,
          "comparison": "greater_than",
          "duration_seconds": 60,
          "action": "scale_up",
          "step": 3,
          "cooldown_seconds": 60,
          "priority": "emergency",
          "alert": true
        },
        {
          "name": "emergency_cpu",
          "metric": "cpu_utilization_percent",
          "condition": "max",
          "threshold": 85,
          "comparison": "greater_than",
          "duration_seconds": 60,
          "action": "scale_up",
          "step": 3,
          "cooldown_seconds": 60,
          "priority": "emergency"
        }
      ]
    },

    "worker": {
      "description": "Background job worker service",
      "min_replicas": 1,
      "max_replicas": 10,
      "scaling_rules": [
        {
          "name": "queue_depth_scale_up",
          "metric": "queue_depth",
          "condition": "sum",
          "threshold": 1000,
          "comparison": "greater_than",
          "duration_seconds": 120,
          "action": "scale_up",
          "step": 2,
          "cooldown_seconds": 180
        },
        {
          "name": "queue_depth_scale_down",
          "metric": "queue_depth",
          "condition": "sum",
          "threshold": 100,
          "comparison": "less_than",
          "duration_seconds": 600,
          "action": "scale_down",
          "step": 1,
          "cooldown_seconds": 600
        },
        {
          "name": "processing_lag_scale_up",
          "metric": "processing_lag_seconds",
          "condition": "max",
          "threshold": 60,
          "comparison": "greater_than",
          "duration_seconds": 120,
          "action": "scale_up",
          "step": 2,
          "cooldown_seconds": 180
        },
        {
          "name": "cpu_scale_up",
          "metric": "cpu_utilization_percent",
          "condition": "avg",
          "threshold": 70,
          "comparison": "greater_than",
          "duration_seconds": 180,
          "action": "scale_up",
          "step": 1,
          "cooldown_seconds": 120
        },
        {
          "name": "cpu_scale_down",
          "metric": "cpu_utilization_percent",
          "condition": "avg",
          "threshold": 30,
          "comparison": "less_than",
          "duration_seconds": 600,
          "action": "scale_down",
          "step": 1,
          "cooldown_seconds": 600
        }
      ]
    },

    "litellm": {
      "description": "LLM router service (LiteLLM)",
      "min_replicas": 1,
      "max_replicas": 5,
      "scaling_rules": [
        {
          "name": "request_rate_scale_up",
          "metric": "requests_per_second",
          "condition": "per_replica_avg",
          "threshold": 500,
          "comparison": "greater_than",
          "duration_seconds": 120,
          "action": "scale_up",
          "step": 1,
          "cooldown_seconds": 180
        },
        {
          "name": "request_rate_scale_down",
          "metric": "requests_per_second",
          "condition": "per_replica_avg",
          "threshold": 100,
          "comparison": "less_than",
          "duration_seconds": 600,
          "action": "scale_down",
          "step": 1,
          "cooldown_seconds": 600
        },
        {
          "name": "latency_scale_up",
          "metric": "p95_latency_ms",
          "condition": "avg",
          "threshold": 2000,
          "comparison": "greater_than",
          "duration_seconds": 120,
          "action": "scale_up",
          "step": 1,
          "cooldown_seconds": 180
        },
        {
          "name": "memory_scale_up",
          "metric": "memory_utilization_percent",
          "condition": "avg",
          "threshold": 80,
          "comparison": "greater_than",
          "duration_seconds": 120,
          "action": "scale_up",
          "step": 1,
          "cooldown_seconds": 120
        }
      ]
    }
  },

  "database": {
    "description": "PostgreSQL — vertical scaling only",
    "scaling_rules": [
      {
        "name": "connection_pool_high",
        "metric": "active_connections_percent",
        "condition": "max",
        "threshold": 80,
        "comparison": "greater_than",
        "duration_seconds": 300,
        "action": "alert",
        "message": "Database connection pool nearing capacity. Consider increasing PgBouncer pool size or adding read replicas."
      },
      {
        "name": "disk_usage_high",
        "metric": "disk_usage_percent",
        "condition": "max",
        "threshold": 85,
        "comparison": "greater_than",
        "duration_seconds": 600,
        "action": "alert",
        "message": "Database disk usage critical. Consider vertical scaling or data archival."
      }
    ]
  },

  "cache": {
    "description": "Redis — vertical scaling only",
    "scaling_rules": [
      {
        "name": "memory_high",
        "metric": "memory_usage_percent",
        "condition": "max",
        "threshold": 90,
        "comparison": "greater_than",
        "duration_seconds": 60,
        "action": "alert",
        "message": "Redis memory usage critical. Consider increasing maxmemory limit or enabling eviction."
      },
      {
        "name": "hit_rate_low",
        "metric": "cache_hit_rate_percent",
        "condition": "avg",
        "threshold": 50,
        "comparison": "less_than",
        "duration_seconds": 300,
        "action": "alert",
        "message": "Redis cache hit rate is low. Review cache key strategy and TTL settings."
      }
    ]
  }
}
