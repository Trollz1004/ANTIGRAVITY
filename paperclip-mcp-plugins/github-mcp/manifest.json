{
  "name": "github-mcp",
  "description": "GitHub MCP plugin for Paperclip, wrapping gh CLI commands",
  "version": "1.0.0",
  "tools": [
    {
      "name": "list_repos",
      "description": "List GitHub repositories for the authenticated user",
      "parameters": {"type": "object", "properties": {}, "required": []},
      "command": "gh repo list --json name,url"
    },
    {
      "name": "create_issue",
      "description": "Create a GitHub issue",
      "parameters": {"type": "object", "properties": {"repo": {"type": "string"}, "title": {"type": "string"}, "body": {"type": "string"}}, "required": ["repo", "title"]},
      "command": "gh issue create --repo {repo} --title \"{title}\" --body \"{body}\""
    }
  ]
}
