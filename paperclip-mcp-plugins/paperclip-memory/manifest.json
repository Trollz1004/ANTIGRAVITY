{
  "name": "paperclip-memory",
  "description": "Compact per-agent state brain for Paperclip. Reads and writes STATE.md files, with optional Supabase persistence.",
  "version": "1.0.0",
  "owner": "sabretooth",
  "nodeId": "sabretooth",
  "env": {
    "SUPABASE_URL": "${SUPABASE_URL}",
    "SUPABASE_SERVICE_ROLE_KEY": "${SUPABASE_SECRET_KEY}"
  },
  "tools": [
    {
      "name": "read_state",
      "description": "Read the current compact state for a Paperclip agent. Returns local STATE.md content; falls back to Supabase if local file is missing.",
      "parameters": {
        "type": "object",
        "properties": {
          "agent_id": {"type": "string", "description": "e.g. paperclip-agents-ceo"},
          "node_id": {"type": "string", "description": "Source node (sabretooth, t5500, etc.)"}
        },
        "required": ["agent_id", "node_id"]
      },
      "command": "node C:\\\\antigravity\\\\scripts\\\\paperclip\\\\mcp-memory-bridge.js read {agent_id} {node_id}"
    },
    {
      "name": "write_state",
      "description": "Append a session delta to the agent STATE.md and mirror it to Supabase. Enforces the per-agent size cap.",
      "parameters": {
        "type": "object",
        "properties": {
          "agent_id": {"type": "string", "description": "e.g. paperclip-agents-ceo"},
          "node_id": {"type": "string", "description": "Source node (sabretooth, t5500, etc.)"},
          "delta_md": {"type": "string", "description": "Concise markdown delta to append under Recent Decisions/Next Actions."}
        },
        "required": ["agent_id", "node_id", "delta_md"]
      },
      "command": "node C:\\\\antigravity\\\\scripts\\\\paperclip\\\\mcp-memory-bridge.js write {agent_id} {node_id} \"{delta_md}\""
    },
    {
      "name": "list_caps",
      "description": "List all agent STATE.md size caps.",
      "parameters": {"type": "object", "properties": {}, "required": []},
      "command": "powershell -Command \"Get-Content C:\\\\antigravity\\\\paperclip\\\\agents\\\\memory-architecture.md | Select-String -Pattern 'Size Caps' -Context 0,10\""
    }
  ]
}
