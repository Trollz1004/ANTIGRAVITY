# Twitter API Keys - Copy from Sabretooth vault
# C:\OPUSONLY\.vault\MASTER-UNIVERSAL-ENV-TROLLZ1004.env
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Apify — web scraping platform for trend research + content seeding
# Account: console.apify.com (GitHub OAuth — Josh)
# Get token: console.apify.com/settings/integrations → Create new token → name it ANTIGRAVITY
# Used by: scripts/apify_content_scout.py, .vscode/mcp.json (Apify MCP server)
# Free tier: $5/month credits, no card required
APIFY_TOKEN=

# Ollama base URL — override if Ollama is on a different host (default: localhost:11434)
# SABRETOOTH local: http://192.168.0.8:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CONTENT_MODEL=qwen2.5:7b
