{
  "service": "dateapp-backend",
  "node": "t5500",
  "envFile": ".env",
  "required": [
    "JWT_SECRET",
    "DATABASE_URL"
  ],
  "alternatives": {
    "JWT_SECRET": [
      "SECRET_KEY"
    ],
    "DATABASE_URL": [
      "SUPABASE_DB_URL"
    ]
  },
  "optional": [
    "APP_ENV",
    "REDIS_URL",
    "SQUARE_ACCESS_TOKEN",
    "SQUARE_LOCATION_ID",
    "AGENT_DRIFT_PATH",
    "ENV_STATUS_PATH"
  ]
}
