# Environment variables for Agent Health Monitor
# Copy this file to .env and update with your values

# Paperclip API Configuration
PAPERCLIP_API_URL=http://localhost:3100/api
PAPERCLIP_API_KEY=your_paperclip_api_key_here
PAPERCLIP_COMPANY_ID=your_company_id_here

# Email Alert Configuration (optional)
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_FROM=alerts@yourcompany.com
ALERT_EMAIL_TO=admin@yourcompany.com
SMTP_SERVER=localhost
SMTP_PORT=587
# SMTP_USER=your_smtp_user (uncomment if authentication needed)
# SMTP_PASSWORD=your_smtp_password (uncomment if authentication needed)