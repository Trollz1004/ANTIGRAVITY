{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "youandinotai",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/next/dist/bin/next", "dev", "-p", "3010"],
      "port": 3010,
      "cwd": "apps/youandinotai-frontend"
    },
    {
      "name": "antigravity",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/next/dist/bin/next", "dev", "-p", "3001"],
      "port": 3001,
      "cwd": "antigravity"
    },
    {
      "name": "revenue-core",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/vite/bin/vite.js", "--host", "--port", "3002"],
      "port": 3002,
      "cwd": "revenue-core"
    },
    {
      "name": "brain-mcp",
      "runtimeExecutable": "node",
      "runtimeArgs": ["dist/index.js"],
      "port": 3900,
      "cwd": "brain-mcp",
      "env": {
        "BRAIN_TRANSPORT": "http",
        "BRAIN_HTTP_PORT": "3900",
        "BRAIN_REQUIRE_AUTH": "false"
      }
    },
    {
      "name": "hermes-workspace-gui",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 3005,
      "cwd": "hermes-workspace",
      "env": {
        "PORT": "3005"
      }
    },
    {
      "name": "mission-mcp",
      "runtimeExecutable": "node",
      "runtimeArgs": ["dist/server.js"],
      "port": 3901,
      "cwd": "services/mission-mcp",
      "env": {
        "MISSION_MCP_TRANSPORT": "http",
        "MISSION_MCP_PORT": "3901"
      }
    },
    {
      "name": "hermes-router",
      "runtimeExecutable": "python",
      "runtimeArgs": ["hermes_router.py"],
      "port": 11435,
      "cwd": "services/hermes-router",
      "env": {
        "HERMES_ROUTER_PORT": "11435"
      }
    }
  ]
}
