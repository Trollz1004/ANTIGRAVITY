{
  "name": "fcc-claude",
  "description": "Free Claude Code via OpenRouter NVIDIA Nemotron + free-tier routes. No local proxy needed.",
  "runtime": "local",
  "command": "fcc-claude --model \"${FCC_MODEL:-openrouter/nvidia/nemotron-3-super-120b-a12b:free}\" -p \"$TASK\" --max-turns 10",
  "env_source": "~/.fcc/.env",
  "port": null,
  "admin_ui": null,
  "models": {
    "opus": "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
    "sonnet": "openrouter/nvidia/nemotron-3-super-120b-a12b:free",
    "haiku": "openrouter/nvidia/nemotron-3-nano-30b-a3b:free",
    "fallback": "openrouter/nvidia/nemotron-nano-9b-v2:free"
  },
  "providers": {
    "openrouter": {
      "enabled": true,
      "base_url": "https://openrouter.ai/api/v1",
      "models": [
        "nvidia/nemotron-3-ultra-550b-a55b:free",
        "nvidia/nemotron-3-super-120b-a12b:free",
        "nvidia/nemotron-3-nano-30b-a3b:free",
        "nvidia/nemotron-nano-9b-v2:free"
      ]
    },
    "ollama": {
      "enabled": true,
      "base_url": "http://127.0.0.1:11434/v1",
      "model": "ornith:9b"
    }
  }
}
