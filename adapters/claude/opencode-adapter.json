{
  "name": "opencode-wsl",
  "description": "OpenCode WSL runtime — multi-provider access (Anthropic/FCC, Google, xAI, OpenRouter, Ollama, Hermes Router)",
  "runtime": "wsl",
  "binary": "/home/trollz/.opencode/bin/opencode",
  "version": "1.17.15",
  "command": "bash -lc 'export PATH=\"$HOME/.local/bin:$PATH\" && source ~/.fcc/.env 2>/dev/null && /home/trollz/.opencode/bin/opencode --model \"${MODEL}\" ${ARGS}'",
  "config": "/mnt/c/ANTIGRAVITY/opencode/opencode-wsl.json",
  "providers": {
    "anthropic": { "via": "fcc-proxy", "base_url": "http://localhost:8082" },
    "google": { "api_key_env": "GEMINI_API_KEY", "models": ["gemini-2.5-pro", "gemini-2.5-flash"] },
    "xai": { "api_key_env": "XAI_API_KEY", "models": ["grok-3", "grok-3-mini", "grok-3-reasoning"] },
    "openrouter": { "api_key_env": "OPENROUTER_API_KEY", "free_models": true },
    "ollama": { "base_url": "http://localhost:11434/v1", "local": true },
    "hermes_router": { "base_url": "http://localhost:11435/v1" }
  },
  "builtin_agents": ["orchestrator", "coder", "hunter", "free-fast", "grok-adversarial"]
}
