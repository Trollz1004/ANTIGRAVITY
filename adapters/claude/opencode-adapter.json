{
  "name": "opencode-wsl",
  "description": "OpenCode WSL runtime — multi-provider access: OpenCode Zen, Anthropic/Claude, OpenAI/GPT Codex, xAI/Grok, Google/Gemini, OpenRouter free, Ollama Cloud, Ollama Local, GitHub Copilot, Hermes Router. Auth via API keys, OAuth, or CLI login.",
  "runtime": "wsl",
  "binary": "/home/trollz/.opencode/bin/opencode",
  "version": "1.18.3",
  "command": "bash -lc 'export PATH=\"$HOME/.local/bin:$PATH\" && source ~/.fcc/.env 2>/dev/null && /home/trollz/.opencode/bin/opencode --model \"${MODEL}\" ${ARGS}'",
  "config": "/mnt/c/ANTIGRAVITY/opencode/opencode.json",
  "providers": {
    "opencode_zen": { "auth": "/connect → zen (OAuth)", "free_models": true },
    "anthropic": { "auth": "ANTHROPIC_API_KEY or Claude Pro/Max OAuth" },
    "codex": { "auth": "ANTHROPIC_API_KEY or Claude Code CLI login" },
    "openai": { "auth": "OPENAI_API_KEY or ChatGPT Plus OAuth" },
    "google": { "auth": "GEMINI_API_KEY (Google AI Studio)" },
    "xai": { "auth": "XAI_API_KEY or xAI Builder CLI" },
    "github_copilot": { "auth": "GitHub device code login" },
    "openrouter": { "auth": "OPENROUTER_API_KEY", "free_models": true },
    "ollama": { "auth": "local (no key) or OLLAMA_API_KEY for cloud" },
    "hermes_router": { "auth": "router-auth (local proxy on :11435)" }
  },
  "builtin_agents": ["orchestrator", "coder", "marketing-affiliate", "hunter", "free-fast", "grok-adversarial"]
}
