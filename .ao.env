# Agency Orchestrator — ANTIGRAVITY Node CEO Config
# FCC uses Anthropic /v1/messages API. AO needs OpenAI-compatible.
# Use OpenRouter directly (free models) or FCC's OpenAI-compatible proxy if available.
# FCC's model IDs are like: anthropic/nvidia_nim/nvidia/nemotron-3-super-120b-a12b

# Option 1: OpenRouter direct (recommended for AO - free models)
AO_PROVIDER=openai
AO_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=*** is the best free model on OpenRouter
# For stronger tasks: nousresearch/hermes-3-llama-3.1-405b:free
# For coding: qwen/qwen3-coder:free

# Option 2: FCC proxy (Anthropic API format, not compatible with AO)
# FCC runs on localhost:8082 but uses /v1/messages not /v1/chat/completions
# AO can't use FCC directly without an adapter

# Output directories
AO_OUTPUT_DIR=/mnt/c/Antigravity/ao-output
AO_HOME=/mnt/c/Antigravity/.ao
AO_AGENTS_DIR=/mnt/c/Antigravity/agency-agents