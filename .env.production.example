# =============================================================================
# Production Environment Variables — ANTIGRAVITY
# Copy to .env.production and fill in real values.
# =============================================================================

# ── CDN Configuration ─────────────────────────────────────────────────────────
# Base URL for static asset CDN. All fingerprinted assets will be loaded from
# this origin in production builds.
VITE_CDN_BASE_URL=https://cdn.youandinotai.com

# Cloudflare R2 bucket settings
CDN_REGION=auto
CDN_BUCKET=antigravity-assets

# Cloudflare account ID (found in R2 dashboard sidebar)
CDN_ACCOUNT_ID=your_cloudflare_account_id_here

# R2 API credentials (create at: R2 dashboard → Manage R2 API Tokens)
CDN_ACCESS_KEY_ID=your_r2_access_key_id_here
CDN_SECRET_ACCESS_KEY=your_r2_secret_access_key_here

# Cloudflare API token for cache invalidation (needs Cache Purge permission)
CF_API_TOKEN=your_cloudflare_api_token_here

# Cloudflare zone ID (found in domain overview sidebar)
CF_ZONE_ID=your_cloudflare_zone_id_here

# ── Application ───────────────────────────────────────────────────────────────
# Backend API URL (used by frontend at runtime)
VITE_API_BASE_URL=https://youandinotai.com/api/v1

# ── Feature Flags ─────────────────────────────────────────────────────────────
VITE_ENABLE_BOT_SHIELD=true
VITE_ENABLE_DAILY_CO=true
