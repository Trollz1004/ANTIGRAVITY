# Copy to .env.omniroute-nodes and keep local.
# Laptop runs OmniRoute only; compute nodes run the model servers.

OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=<local-omniroute-key>

# Sabretooth node provided by Josh on 2026-07-21.
SABRETOOTH_OLLAMA_URL=http://192.168.0.8:11434
SABRETOOTH_OPENAI_BASE_URL=http://192.168.0.8:11434/v1

# 9020 node provided by Josh on 2026-07-21.
NODE_9020_OLLAMA_URL=http://192.168.0.5:11434
NODE_9020_OPENAI_BASE_URL=http://192.168.0.5:11434/v1
