# Freebuff CEO bridge — required secrets (copy to .env, NEVER commit .env)
# Generate a token:  openssl rand -hex 24
PAPERCLIP_CEO_BRIDGE_TOKEN=change-me
# Agent API key created via:  npx paperclipai token agent create --company-id 92223de0-... --agent 55461934-... --name freebuff-ceo-bridge
PAPERCLIP_CEO_AGENT_KEY=pcp_...

# Optional overrides
# PAPERCLIP_CEO_BRIDGE_PORT=3140
# PAPERCLIP_API_BASE=http://127.0.0.1:3100
# PAPERCLIP_CEO_WAKES_DIR=C:\ANTIGRAVITY\ops\paperclip-ceo\wakes

# Mission control (task-pool maintenance + Date App health checks)
PAPERCLIP_CEO_COMPANY_ID=92223de0-b36b-4d63-93ca-50ebe5007e68
PAPERCLIP_POOL_TARGET=50
PAPERCLIP_TOP_UP_AT=10
PAPERCLIP_FRONTEND_URL=http://127.0.0.1:3200
PAPERCLIP_BACKEND_HEALTH_URL=http://127.0.0.1:8000/health
PAPERCLIP_SUPPORT_CHAT_URL=http://127.0.0.1:8000/api/v1/support/chat
PAPERCLIP_SITE_HOST=youandinotai.com
PAPERCLIP_CLOUDFLARED_PROCESS=cloudflared
