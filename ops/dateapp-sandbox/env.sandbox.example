# Date app sandbox settings. Square SANDBOX only. Never production.
#
# How to use:
#   1. Run start-sandbox.ps1 once. It copies this file to
#      %LOCALAPPDATA%\dateapp-sandbox\env.sandbox and stops.
#   2. Open that copy (not this one) and fill the two empty lines marked JOSH FILLS.
#   3. Run start-sandbox.ps1 again.
# Never paste a token into this example file. This repo is public.
# The start script expands %LOCALAPPDATA% in any value below.

# ---- Which copy this is ----
# Marks this backend as the sandbox copy. Not "production" and not "test".
APP_ENV=sandbox

# ---- Square (sandbox) ----
# Square's sandbox API host. The start script refuses to run if this is anything else.
SQUARE_API_BASE_URL=https://connect.squareupsandbox.com
# Square API version the backend sends. Same value production uses.
SQUARE_API_VERSION=2026-01-22
# JOSH FILLS: Sandbox access token. Square Developer page, your app, Credentials, Sandbox tab.
SQUARE_ACCESS_TOKEN=
# JOSH FILLS: Sandbox location id. Square Developer page, your app, Locations, Sandbox tab.
SQUARE_LOCATION_ID=
# Pre-made production payment links. Must stay empty here.
SQUARE_BOT_SHIELD_PAYMENT_LINK=
SQUARE_SUBSCRIPTION_PAYMENT_LINK=

# ---- Square webhook signature checking ----
# Signature checking stays on. The backend rejects any payment event without a valid signature.
SQUARE_WEBHOOK_VERIFY_SIGNATURE=true
# Local signing key for replayed sandbox events. Leave empty; the start script fills a random one.
SQUARE_PAYMENT_WEBHOOK_SIGNATURE_KEY=
# Address the signature is computed over. Local backend only.
SQUARE_PAYMENT_WEBHOOK_NOTIFICATION_URL=http://127.0.0.1:8460/api/v1/webhooks/square-payment
# Older shared webhook settings and booking webhook settings. Unused here; keep empty.
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=
SQUARE_BOOKING_WEBHOOK_SIGNATURE_KEY=
SQUARE_BOOKING_WEBHOOK_NOTIFICATION_URL=
# Folder for booking webhook logs. Local folder only.
SQUARE_BOOKING_LOG_DIR=%LOCALAPPDATA%\dateapp-sandbox\booking-logs

# ---- Database (local test copy) ----
# Local SQLite file for this test copy. Never the production database.
DATABASE_URL=sqlite+aiosqlite:///%LOCALAPPDATA%\dateapp-sandbox\sandbox.db
# Cloud database address. Must stay empty here; the start script refuses if it is set.
SUPABASE_DB_URL=

# ---- Sign-in ----
# Signing secret for sign-in tokens. Leave empty; the start script fills a random one.
JWT_SECRET=
# Sign-in token lifetime in minutes. Same as production.
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh token lifetime in days. Same as production.
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Local addresses ----
# Port for the sandbox backend. Not 3200, 8000, 9160 or 3130.
SANDBOX_BACKEND_PORT=8460
# Port for the sandbox front end. Not 3200, 8000, 9160 or 3130.
SANDBOX_FRONTEND_PORT=3460
# Where Square's checkout page sends the buyer back after paying.
APP_URL=http://127.0.0.1:3460
# Front end address the backend accepts calls from.
CORS_ORIGINS=http://127.0.0.1:3460
# Backend address the front end calls.
VITE_API_URL=http://127.0.0.1:8460/api/v1

# ---- Supporting services ----
# Local Redis, separate database number 15. If Redis is not running the backend keeps going.
REDIS_URL=redis://127.0.0.1:6379/15
# Metrics side server off. Its default port is 8000, which this copy must not use.
PROMETHEUS_PORT=0
# Error reporting off for this copy.
SENTRY_DSN=
# Uploaded photos stay in a local folder.
UPLOAD_STORAGE_PATH=%LOCALAPPDATA%\dateapp-sandbox\uploads

# ---- Everything else off ----
# No real email, chat alerts, other payment rails or AI keys in this copy.
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PLAID_CLIENT_ID=
PLAID_SECRET=
TELEGRAM_BOT_TOKEN=
WHATSAPP_TOKEN=
GEMINI_API_KEY=
KIMI_API_KEY=
DAILY_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CLAWX_ENABLED=false
