# ANTIGRAVITY Docker Compose Configuration — Template
# Copy this to .env.docker and fill in your API keys
# 
# REQUIRED: At least ONE LLM provider key below
# 
# OpenAI (GPT-4, o-series)
OPENAI_API_KEY=

# OpenRouter (multi-model, has free tier)
OPENROUTER_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# Other optional providers
# GROQ_API_KEY=
# COHERE_API_KEY=

# ─────────────────────────────────────────────────────────────────
# Hermes Workspace Configuration
# ─────────────────────────────────────────────────────────────────

# Password for Hermes Workspace web UI (no login required if set to empty)
HERMES_PASSWORD=antigravity

# ─────────────────────────────────────────────────────────────────
# Cloudflare Configuration (Optional)
# ─────────────────────────────────────────────────────────────────

# Cloudflare Tunnel Token (get from https://dash.cloudflare.com/)
# Only needed if using: docker-compose --profile cloudflare up
# CLOUDFLARE_TUNNEL_TOKEN=

# ─────────────────────────────────────────────────────────────────
# Advanced (Usually No Changes Needed)
# ─────────────────────────────────────────────────────────────────

# Cookie security (0=HTTP local, 1=HTTPS/production)
COOKIE_SECURE=0

# Trust reverse proxy headers (only behind sanitizing proxy)
TRUST_PROXY=1
